#!/usr/bin/env python3
"""
npm-health-endpoint: HTTP health endpoint for load balancers and monitoring.

Serves GET /health on a configurable port (default 9180), bound to 127.0.0.1 by default.
Returns JSON: {"status":"pass|warn|fail","checks":[...],"timestamp":"..."}

Configure via environment or /etc/default/npm-health-endpoint:
  NPM_HEALTH_BIND=127.0.0.1
  NPM_HEALTH_PORT=9180

Operators must open port 9180 in security groups if external health checks are desired;
default bind to 127.0.0.1 keeps it local-only.
"""

import json
import os
import subprocess
from http.server import BaseHTTPRequestHandler, HTTPServer
from typing import Optional

DEFAULT_BIND = "127.0.0.1"
DEFAULT_PORT = 9180


def load_env_file(path: str = "/etc/default/npm-health-endpoint") -> None:
    """Load environment variables from a file if it exists."""
    if not os.path.exists(path):
        return
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, _, value = line.partition("=")
                    key = key.strip()
                    value = value.strip().strip('"').strip("'")
                    if key:
                        os.environ.setdefault(key, value)
    except OSError:
        pass


def run_health_report_json() -> Optional[dict]:
    """Run npm-helper health-report --json and return parsed output."""
    try:
        proc = subprocess.run(
            ["/usr/local/bin/npm-helper", "health-report", "--json"],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if proc.returncode != 0 or not proc.stdout.strip():
            return None
        return json.loads(proc.stdout)
    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileNotFoundError):
        return None


def format_health_response(report: Optional[dict]) -> tuple[str, int]:
    """Convert report to plan-specified format. Returns (json_str, status_code)."""
    if report is None:
        payload = {
            "status": "fail",
            "checks": [{"name": "health_report", "status": "fail", "message": "unable to run"}],
            "timestamp": "",
        }
        return json.dumps(payload), 503
    payload = {
        "status": report.get("overall_status", "unknown"),
        "checks": report.get("checks", []),
        "timestamp": report.get("generated_at", ""),
    }
    status = payload["status"]
    status_code = 200 if status == "pass" else (503 if status == "fail" else 200)
    return json.dumps(payload), status_code


class HealthHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health" or self.path == "/health/":
            report = run_health_report_json()
            body, code = format_health_response(report)
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body.encode("utf-8"))
        else:
            self.send_response(404)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"Not Found")

    def log_message(self, format, *args):  # pylint: disable=arguments-differ
        pass  # Quiet by default; use journalctl for service logs


def main() -> None:
    load_env_file()
    bind = os.environ.get("NPM_HEALTH_BIND", DEFAULT_BIND)
    port = int(os.environ.get("NPM_HEALTH_PORT", str(DEFAULT_PORT)))
    server = HTTPServer((bind, port), HealthHandler)
    server.serve_forever()


if __name__ == "__main__":
    main()
