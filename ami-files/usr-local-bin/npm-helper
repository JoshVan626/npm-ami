def cmd_upgrade(dry_run: bool = False) -> None:
    """
    Safely upgrade the NPM stack using the existing compose file pins.
    """
    require_root("upgrade")

    compose_dir = "/opt/npm"
    compose_file = Path(f"{compose_dir}/docker-compose.yml")
    backup_dir = get_backup_dir()
    min_free_bytes = 1024 * 1024 * 1024  # 1 GiB
    steps = [
        "Preflight checks",
        "Run npm-backup",
        "docker compose pull",
        "Restart npm.service",
        "Post-upgrade health check",
    ]

    print("NPM Upgrade (safe, backup-first)")
    print("=" * 50)
    if dry_run:
        print("Dry run mode: no changes will be made.")
        print("")

    # Preflight checks
    issues = []
    if not compose_file.exists():
        issues.append(f"compose file missing: {compose_file}")

    try:
        docker_state = run_cmd(["systemctl", "is-active", "docker"], timeout=5)
        if docker_state.returncode != 0 or docker_state.stdout.strip() != "active":
            issues.append("docker service is not active")
    except Exception:
        issues.append("unable to check docker service status")

    if not Path("/usr/local/bin/npm-backup").exists():
        issues.append("npm-backup not found")

    if not Path(backup_dir).exists():
        issues.append(f"backup dir not found: {backup_dir}")
    elif not os.access(backup_dir, os.W_OK):
        issues.append(f"backup dir not writable: {backup_dir}")
    else:
        try:
            backup_usage = shutil.disk_usage(backup_dir)
            if backup_usage.free < min_free_bytes:
                issues.append(f"low disk space in backup dir (less than 1GiB free): {backup_dir}")
        except Exception:
            issues.append(f"unable to check disk space in backup dir: {backup_dir}")

    try:
        usage = shutil.disk_usage("/")
        if usage.free < min_free_bytes:
            issues.append("low disk space on / (less than 1GiB free)")
    except Exception:
        issues.append("unable to check disk space on /")

    if issues:
        print("Preflight checks failed:")
        for issue in issues:
            print(f" - {issue}")
        sys.exit(1)

    if dry_run:
        print("Planned steps:")
        for step in steps:
            print(f" - {step}")
        sys.exit(0)

    backup_path = None
    print("Running safety backup...")
    backup_proc = run_cmd(["/usr/local/bin/npm-backup"], timeout=1800)
    if backup_proc.returncode != 0:
        print("Error: backup failed; aborting upgrade.")
        if backup_proc.stdout:
            print(backup_proc.stdout.strip())
        if backup_proc.stderr:
            print(backup_proc.stderr.strip())
        sys.exit(1)
    if backup_proc.stdout.strip():
        print(backup_proc.stdout.strip())
    for line in backup_proc.stdout.splitlines():
        if "NORTHSTAR_BACKUP" in line and "path=" in line:
            backup_path = line.split("path=", 1)[1].strip().split()[0]
            break
    if not backup_path:
        backup_path = "unknown"

    print("Pulling container images...")
    pull_proc = run_cmd(["docker", "compose", "pull"], cwd=compose_dir, timeout=1800)
    if pull_proc.returncode != 0:
        print("Error: docker compose pull failed.")
        if pull_proc.stdout:
            print(pull_proc.stdout.strip())
        if pull_proc.stderr:
            print(pull_proc.stderr.strip())
        sys.exit(1)

    print("Restarting NPM stack...")
    restart_proc = run_cmd(["systemctl", "restart", "npm.service"], timeout=300)
    if restart_proc.returncode != 0:
        print("Error: failed to restart npm.service.")
        sys.exit(1)

    print("Post-upgrade health check...")
    health_ok = False
    try:
        ps = run_cmd(["docker", "compose", "ps", "--format", "json"], cwd=compose_dir, timeout=10)
        if ps.returncode == 0 and ps.stdout.strip():
            containers = []
            for line in ps.stdout.strip().splitlines():
                try:
                    obj = json.loads(line)
                    containers.append(obj)
                except Exception:
                    continue
            if any(c.get("State") == "running" for c in containers):
                health_ok = True
    except Exception:
        pass

    if shutil.which("curl"):
        curl = run_cmd(["curl", "-sS", "-m", "5", "http://localhost:81"], timeout=10)
        if curl.returncode == 0:
            health_ok = True

    if not health_ok:
        print("Error: health check did not confirm NPM is running.")
        print("Check 'docker compose ps' or systemctl status npm.service for details.")
        print("Rollback steps:")
        print(f"  1. sudo npm-helper restore {backup_path}")
        print("  2. sudo systemctl restart npm.service")
        sys.exit(1)

    print("")
    print("Upgrade completed.")
    print(f"Backup used: {backup_path}")
    print("Rollback steps:")
    print(f"  1. sudo npm-helper restore {backup_path}")
    print("  2. sudo systemctl restart npm.service")
    sys.exit(0)


def cmd_backup_verify() -> None:
    """
    Verify the most recent backup archive for expected contents.
    """
    require_root("backup verify")
    backup_dir = Path(get_backup_dir())
    min_size_bytes = 1024 * 1024  # 1 MiB
    retention = get_backup_retention()

    print("NPM Backup Verification")
    print("=" * 50)

    if not backup_dir.exists():
        print(f"Backup directory not found: {backup_dir}")
        print("Summary: RED")
        sys.exit(1)

    backups = sorted(backup_dir.glob("npm-*.tar.gz"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not backups:
        print("No backup archives found.")
        print("Summary: RED")
        sys.exit(1)

    latest = backups[0]
    warnings = []
    errors = []

    if latest.stat().st_size < min_size_bytes:
        errors.append(f"backup file is smaller than expected ({latest.stat().st_size} bytes)")

    tar_list = run_cmd(["tar", "-tzf", str(latest)], timeout=30)
    if tar_list.returncode != 0:
        errors.append("unable to read backup archive (tar -tzf failed)")
    else:
        lines = tar_list.stdout.splitlines()
        has_data = any(line.startswith("opt/npm/data/") for line in lines)
        has_letsencrypt = any(line.startswith("opt/npm/letsencrypt/") for line in lines)

        if not has_data:
            errors.append("missing opt/npm/data in archive")
        if not has_letsencrypt:
            warnings.append("missing opt/npm/letsencrypt in archive (no certs yet?)")

    if retention and len(backups) > retention:
        warnings.append(f"backup count {len(backups)} exceeds retention setting {retention}")

    print(f"Latest backup: {latest}")
    print(f"Size: {latest.stat().st_size} bytes")
    if errors:
        print("Issues:")
        for issue in errors:
            print(f" - {issue}")
    if warnings:
        print("Warnings:")
        for warn in warnings:
            print(f" - {warn}")

    if errors:
        print("Summary: RED")
        sys.exit(1)
    if warnings:
        print("Summary: YELLOW")
        sys.exit(2)

    print("Summary: GREEN")
    sys.exit(0)


def cmd_restore(backup_path: str, dry_run: bool = False) -> None:
    """
    Restore a backup archive. Dry-run validates without changes.
    """
    require_root("restore")
    if not backup_path:
        print("Error: backup archive path required.")
        sys.exit(1)
    backup = Path(backup_path)
    if not backup.exists():
        print(f"Error: backup archive not found: {backup}")
        sys.exit(1)

    if dry_run:
        tar_list = run_cmd(["tar", "-tzf", str(backup)], timeout=30)
        if tar_list.returncode != 0:
            print("Error: unable to read backup archive (tar -tzf failed).")
            sys.exit(1)
        lines = tar_list.stdout.splitlines()
        targets = []
        if any(line.startswith("opt/npm/data/") for line in lines):
            targets.append("/opt/npm/data")
        if any(line.startswith("opt/npm/letsencrypt/") for line in lines):
            targets.append("/opt/npm/letsencrypt")

        if not targets:
            print("Error: backup archive does not contain expected NPM paths.")
            sys.exit(1)

        print("Restore dry run")
        print("=" * 50)
        print(f"Backup archive: {backup}")
        print("Would restore:")
        for target in targets:
            print(f" - {target}")
        sys.exit(0)

    result = subprocess.run(["/usr/local/bin/npm-restore", str(backup)], check=False)
    sys.exit(result.returncode)

def parse_status_line(line: str):
    """
    Parse status files written by preflight/postinit scripts.
    Expected formats:
      OK <timestamp>
      FAIL <timestamp> reason=<enum>
    """
    if not line:
        return None
    parts = line.split()
    if len(parts) >= 2 and parts[0] in ("OK", "FAIL"):
        status = "ok" if parts[0] == "OK" else "fail"
        ts = parts[1]
        reason = None
        for p in parts[2:]:
            if p.startswith("reason="):
                reason = p.split("=", 1)[1]
                break
        out = {"status": status, "timestamp": ts}
        if reason:
            out["reason"] = reason
        return out
    return {"raw": line}


def systemd_unit_status(unit: str, errors: list):
    info = {"unit": unit}
    try:
        r_active = run_cmd(["systemctl", "is-active", unit], timeout=5)
        info["active"] = r_active.stdout.strip() if r_active.stdout.strip() else "unknown"
        r_enabled = run_cmd(["systemctl", "is-enabled", unit], timeout=5)
        info["enabled"] = r_enabled.stdout.strip() if r_enabled.stdout.strip() else "unknown"
    except FileNotFoundError:
        errors.append(f"systemctl_not_found:{unit}")
        info["active"] = "unknown"
        info["enabled"] = "unknown"
    except Exception as e:
        errors.append(f"systemctl_error:{unit}:{type(e).__name__}")
        info["active"] = "unknown"
        info["enabled"] = "unknown"
    return info


def cmd_diagnostics(json_mode: bool = False):
    """
    Gather non-sensitive diagnostics for support and troubleshooting.
    """
    errors = []
    core_errors = []

    # Lifecycle markers
    preflight = parse_status_line(read_sentinel_file(PREFLIGHT_STATUS))
    postinit = parse_status_line(read_sentinel_file(POSTINIT_STATUS))
    init_marker = Path(INIT_MARKER_FILE)
    init_info = {"status": "complete" if init_marker.exists() else "incomplete"}
    if init_marker.exists():
        try:
            init_info["timestamp"] = time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(init_marker.stat().st_mtime))
        except Exception:
            pass

    # Systemd statuses (core)
    units = [
        "npm.service",
        "npm-preflight.service",
        "npm-init.service",
        "npm-postinit.service",
        "npm-backup.timer",
        "npm-backup.service",
        "npm-cert-check.timer",
        "npm-cert-check.service",
    ]
    unit_statuses = []
    for u in units:
        st = systemd_unit_status(u, errors)
        unit_statuses.append(st)
        if st.get("active") == "unknown" and st.get("enabled") == "unknown":
            core_errors.append(f"systemd_status_unavailable:{u}")

    # Disk usage (core)
    disk = {}
    try:
        du_root = shutil.disk_usage("/")
        disk["root"] = {
            "path": "/",
            "total_bytes": du_root.total,
            "used_bytes": du_root.used,
            "free_bytes": du_root.free,
            "used_percent": round((du_root.used / du_root.total) * 100, 2) if du_root.total else None,
        }
    except Exception as e:
        core_errors.append(f"disk_usage_error_root:{type(e).__name__}")

    try:
        du_backups = shutil.disk_usage(BACKUP_DIR)
        disk["backups"] = {
            "path": BACKUP_DIR,
            "total_bytes": du_backups.total,
            "used_bytes": du_backups.used,
            "free_bytes": du_backups.free,
            "used_percent": round((du_backups.used / du_backups.total) * 100, 2) if du_backups.total else None,
        }
    except FileNotFoundError:
        disk["backups"] = {"path": BACKUP_DIR, "error": "not_found"}
    except Exception as e:
        errors.append(f"disk_usage_error_backups:{type(e).__name__}")

    # CloudWatch agent status (best-effort)
    cw = {"service": "amazon-cloudwatch-agent.service"}
    cw.update(systemd_unit_status("amazon-cloudwatch-agent.service", errors))

    # IAM availability (best-effort, no AWS SDK; IMDSv2 attempt with short timeouts)
    iam = {"available": "unknown", "method": "imds"}
    try:
        if not shutil.which("curl"):
            raise FileNotFoundError()
        # token
        token = run_cmd(
            ["curl", "-sS", "-m", "1", "-X", "PUT", "http://169.254.169.254/latest/api/token",
             "-H", "X-aws-ec2-metadata-token-ttl-seconds: 60"],
            timeout=2,
        )
        if token.returncode == 0 and token.stdout.strip():
            t = token.stdout.strip()
            role = run_cmd(
                ["curl", "-sS", "-m", "1", "-H", f"X-aws-ec2-metadata-token: {t}",
                 "http://169.254.169.254/latest/meta-data/iam/security-credentials/"],
                timeout=2,
            )
            iam["available"] = bool(role.returncode == 0 and role.stdout.strip())
        else:
            iam["available"] = "unknown"
    except FileNotFoundError:
        iam["available"] = "unknown"
    except Exception:
        iam["available"] = "unknown"

    # NPM container health (best-effort)
    npm_container = {"status": "unknown", "containers": []}
    try:
        r = run_cmd(["docker", "compose", "ps", "--format", "json"], cwd="/opt/npm", timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            for line in r.stdout.strip().splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                    npm_container["containers"].append(
                        {
                            "name": obj.get("Name"),
                            "service": obj.get("Service"),
                            "state": obj.get("State"),
                            "health": obj.get("Health"),
                        }
                    )
                except Exception:
                    continue
            # derive overall status
            if any(c.get("state") == "running" for c in npm_container["containers"]):
                npm_container["status"] = "running"
            elif npm_container["containers"]:
                npm_container["status"] = "not_running"
            else:
                npm_container["status"] = "unknown"
        else:
            npm_container["status"] = "not_found"
    except FileNotFoundError:
        npm_container["status"] = "docker_not_found"
    except Exception as e:
        errors.append(f"docker_compose_ps_error:{type(e).__name__}")

    result = {
        "product": "Nginx Proxy Manager – Hardened Edition AMI",
        "vendor": "Northstar Cloud Solutions LLC",
        "lifecycle": {
            "preflight": preflight,
            "init": init_info,
            "postinit": postinit,
        },
        "systemd": {"units": unit_statuses},
        "disk": disk,
        "cloudwatch": {"agent": cw, "iam_available": iam["available"], "iam_method": iam["method"]},
        "npm": npm_container,
        "errors": errors,
    }

    exit_code = 0
    if core_errors:
        result.setdefault("errors", []).extend(core_errors)
        exit_code = 1

    if json_mode:
        sys.stdout.write(json.dumps(result, separators=(",", ":"), sort_keys=True) + "\n")
        sys.exit(exit_code)

    # Human output (keep concise)
    print("NPM Diagnostics")
    print("=" * 50)
    print(f"Init: {init_info.get('status')}")
    if preflight:
        print(f"Preflight: {preflight}")
    if postinit:
        print(f"Post-init: {postinit}")
    print("")
    for u in unit_statuses:
        print(f"{u['unit']}: active={u.get('active')} enabled={u.get('enabled')}")
    if disk.get("root"):
        print(f"Disk / used_percent={disk['root'].get('used_percent')}%")
    if disk.get("backups") and isinstance(disk["backups"], dict) and disk["backups"].get("used_percent") is not None:
        print(f"Disk {BACKUP_DIR} used_percent={disk['backups'].get('used_percent')}%")
    print(f"CloudWatch agent active={cw.get('active')} enabled={cw.get('enabled')} iam_available={iam.get('available')}")
    print(f"NPM containers status={npm_container.get('status')}")
    if errors:
        print("Errors:")
        for e in errors:
            print(f" - {e}")
    sys.exit(exit_code)


def cmd_show_admin():
    """
    Display the current admin username and credentials file location.
    
    Exits with code 1 if credentials file does not exist.
    """
    require_root("show-admin")
    cred_file = migrate_legacy_credentials()
    
    if not cred_file.exists():
        print("Error: Credentials file not found.")
        print("Did npm-init run yet?")
        sys.exit(1)
    
    try:
        with open(cred_file, 'r') as f:
            lines = f.readlines()
        
        username = None
        
        for line in lines:
            line = line.strip()
            if line.startswith("Username:"):
                username = line.split(":", 1)[1].strip()
        
        if not username:
            print("Error: Could not parse credentials file.")
            sys.exit(1)
        
        print(f"Admin user: {username}")
        print(f"Credentials file: {cred_file}")
        print("For security, use 'sudo npm-helper show-creds' to display the password.")
        
    except Exception as e:
        print(f"Error reading credentials file: {e}")
        sys.exit(1)


def confirm_sensitive_action(assume_yes: bool, action_label: str) -> None:
    if assume_yes:
        return
    if not sys.stdin.isatty():
        print(f"Error: {action_label} requires confirmation. Re-run with --yes.")
        sys.exit(1)
    response = input(f"WARNING: This will display sensitive credentials. Type 'yes' to continue: ")
    if response.strip().lower() != "yes":
        print("Aborted.")
        sys.exit(1)


def log_credential_access(user: str) -> None:
    log_path = Path(CRED_ACCESS_LOG)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(log_path.parent, 0o750)
    try:
        os.chown(log_path.parent, 0, 0)
    except PermissionError:
        pass

    timestamp = time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime())
    entry = f"{timestamp} user={user} action=show-creds\n"
    with open(log_path, "a", encoding="utf-8") as log_file:
        log_file.write(entry)
    os.chmod(log_path, 0o600)
    try:
        os.chown(log_path, 0, 0)
    except PermissionError:
        pass


def cmd_show_creds(assume_yes: bool = False) -> None:
    """
    Display the current admin credentials from the credentials file.
    """
    require_root("show-creds")
    cred_file = migrate_legacy_credentials()

    if not cred_file.exists():
        print("Error: Credentials file not found.")
        print("Did npm-init run yet?")
        sys.exit(1)

    confirm_sensitive_action(assume_yes, "show-creds")

    user = os.environ.get("SUDO_USER") or os.environ.get("USER") or getpass.getuser()
    log_credential_access(user)

    try:
        with open(cred_file, "r", encoding="utf-8") as f:
            sys.stdout.write(f.read())
    except Exception as e:
        print(f"Error reading credentials file: {e}")
        sys.exit(1)


def cmd_rotate_admin():
    """
    Generate a new admin password and update the database, credentials file, and MOTD.
    
    Exits with code 1 on errors (database timeout, user not found, etc.).
    """
    print("Rotating admin password...")
    
    # Wait for database to be ready
    try:
        print(f"Waiting for database at {DB_PATH}...")
        wait_for_db(DB_PATH)
        print("Database is ready.")
    except DatabaseTimeoutError as e:
        print(f"Error: {e}")
        sys.exit(1)
    
    # Get database connection
    try:
        conn = get_sqlite_connection(DB_PATH)
    except Exception as e:
        print(f"Error connecting to database: {e}")
        sys.exit(1)
    
    try:
        # Look up admin user
        try:
            user_id = get_admin_user_id(conn, ADMIN_EMAIL)
            print(f"Found admin user with ID: {user_id}")
        except AdminUserNotFoundError as e:
            print(f"Error: {e}")
            conn.close()
            sys.exit(1)
        
        # Generate new password
        new_password = generate_password()
        print("Generated new admin password.")
        
        # Hash the password
        password_hash = hash_password(new_password)
        
        # Update password in database
        try:
            set_admin_password(conn, user_id, password_hash)
            print("Password updated in database.")
        except AuthRecordNotFoundError as e:
            print(f"Error: {e}")
            conn.close()
            sys.exit(1)
        
        # Write credentials file
        try:
            write_credentials_file(CREDENTIALS_PATH, ADMIN_EMAIL, new_password)
            migrate_legacy_credentials()
            print("Credentials written to root-only credentials file.")
        except Exception as e:
            print(f"Error writing credentials file: {e}")
            conn.close()
            sys.exit(1)
        
        # Detect IP and update MOTD
        try:
            ip = detect_instance_ip()
            print(f"Detected instance IP: {ip}")
            
            motd_content = build_motd_script(ip, ADMIN_EMAIL)
            
            with open(MOTD_PATH, 'w') as f:
                f.write(motd_content)
            
            # Make MOTD script executable
            os.chmod(MOTD_PATH, 0o755)
            print(f"MOTD script updated at {MOTD_PATH}")
            
        except Exception as e:
            print(f"Warning: Failed to update MOTD: {e}")
            # Don't exit on MOTD failure, password rotation succeeded
        
        conn.close()
        
        print("\nPassword rotation completed successfully!")
        print(f"Admin user: {ADMIN_EMAIL}")
        print("New password: (not displayed)")
        print(f"Credentials stored at: {CREDENTIALS_PATH}")
        
    except Exception as e:
        print(f"Unexpected error during password rotation: {e}")
        conn.close()
        sys.exit(1)


def read_sentinel_file(filepath: str) -> str:
    """
    Read the contents of a sentinel file.
    
    Args:
        filepath: Path to the sentinel file
    
    Returns:
        Contents of the file, or None if file doesn't exist or is unreadable
    """
    try:
        sentinel = Path(filepath)
        if sentinel.exists() and sentinel.is_file():
            return sentinel.read_text().strip()
    except Exception:
        pass
    return None


def cmd_status():
    """
    Display system and service status.
    
    Shows:
    - Docker service status
    - npm service status
    - NPM container status
    - Backup status (last run, last success, last failure)
    
    Exits with code 0 unless an unexpected error occurs.
    """
    status_info = {}
    unit_info = []
    
    # Check Docker service status
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "docker"],
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            status_info["docker"] = result.stdout.strip()
        else:
            status_info["docker"] = "inactive"
    except Exception as e:
        status_info["docker"] = f"unknown (error: {e})"
    
    # Check npm service status
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "npm"],
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            status_info["npm"] = result.stdout.strip()
        else:
            status_info["npm"] = "inactive"
    except Exception as e:
        status_info["npm"] = f"unknown (error: {e})"
    
    # Check NPM container status
    container_status = "unknown"
    try:
        result = subprocess.run(
            ["docker", "compose", "ps", "--format", "json"],
            cwd="/opt/npm",
            capture_output=True,
            text=True,
            timeout=10
        )
        if result.returncode == 0 and result.stdout.strip():
            # Parse JSON output to determine container state
            import json
            lines = result.stdout.strip().split('\n')
            for line in lines:
                if line.strip():
                    try:
                        container = json.loads(line)
                        state = container.get("State", "unknown")
                        if state == "running":
                            container_status = "running"
                            break
                        elif state in ["exited", "stopped"]:
                            container_status = "exited"
                    except json.JSONDecodeError:
                        pass
        else:
            container_status = "not found"
    except FileNotFoundError:
        container_status = "docker compose not available"
    except Exception as e:
        container_status = f"error checking ({e})"
    
    status_info["container"] = container_status

    # Systemd unit status (core + timers)
    units = ["npm.service", "npm-init.service", "npm-backup.timer", "npm-cert-check.timer"]
    for unit in units:
        info = {"unit": unit, "active": "unknown", "enabled": "unknown"}
        try:
            active = run_cmd(["systemctl", "is-active", unit], timeout=5)
            enabled = run_cmd(["systemctl", "is-enabled", unit], timeout=5)
            info["active"] = active.stdout.strip() if active.stdout.strip() else "unknown"
            info["enabled"] = enabled.stdout.strip() if enabled.stdout.strip() else "unknown"
        except Exception as e:
            info["error"] = str(e)
        unit_info.append(info)
    
    # Find last backup file
    last_backup_file = "none found"
    try:
        backup_dir = Path(BACKUP_DIR)
        if backup_dir.exists() and backup_dir.is_dir():
            backup_files = list(backup_dir.glob("npm-*.tar.gz"))
            if backup_files:
                # Sort by modification time, most recent first
                backup_files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
                last_backup_file = backup_files[0].name
    except Exception as e:
        last_backup_file = f"error checking ({e})"
    
    # Read backup status from sentinel files
    backup_last_run = read_sentinel_file(SENTINEL_LAST_RUN)
    backup_last_success = read_sentinel_file(SENTINEL_LAST_SUCCESS)
    backup_last_failure = read_sentinel_file(SENTINEL_LAST_FAILURE)

    # Read first-boot status
    preflight_status = read_sentinel_file(PREFLIGHT_STATUS)
    postinit_status = read_sentinel_file(POSTINIT_STATUS)
    init_complete = Path(INIT_MARKER_FILE).exists()
    
    # Admin UI allowlist (UFW)
    admin_access_lines = []
    try:
        if shutil.which("ufw"):
            status_output = ufw_status()
            allowlist = parse_ufw_allowlist_81(status_output)
            if "Status: inactive" in status_output:
                admin_access_lines.append("UFW: inactive (security group controls access)")
            if not allowlist:
                admin_access_lines.append("Admin UI port 81: restricted (no allowlist rules)")
            else:
                admin_access_lines.append("Admin UI port 81: allowlist active")
                for line in allowlist:
                    admin_access_lines.append(f"  - {line}")
        else:
            admin_access_lines.append("UFW: not installed")
    except Exception as e:
        admin_access_lines.append(f"Admin UI access: unknown ({e})")

    # Certificate expiry summary
    threshold = read_config_int(CERT_CHECK_CONFIG, "cert-check", "threshold_days", DEFAULT_CERT_THRESHOLD_DAYS)
    cert_summary = get_cert_expiry_summary(threshold)

    # Print status summary
    print("NPM System Status")
    print("=" * 50)
    print(f"Docker service:   {status_info['docker']}")
    print(f"npm service:      {status_info['npm']}")
    print(f"NPM container:    {status_info['container']}")
    print("")
    print("Systemd Units")
    print("-" * 50)
    for info in unit_info:
        print(f"{info['unit']}: active={info.get('active')} enabled={info.get('enabled')}")
    print("=" * 50)
    print("")
    print("Initialization Status")
    print("-" * 50)
    if preflight_status:
        print(f"Preflight:       {preflight_status}")
    else:
        print("Preflight:       not yet run")
    print(f"Init:            {'complete' if init_complete else 'incomplete'}")
    if postinit_status:
        print(f"Post-init:       {postinit_status}")
    else:
        print("Post-init:       not yet run")
    print("-" * 50)
    print("")
    print("Admin UI Access")
    print("-" * 50)
    for line in admin_access_lines:
        print(line)
    print("-" * 50)

    print("")
    print("Backup Status")
    print("-" * 50)
    print(f"Last backup file: {last_backup_file}")
    
    if backup_last_run:
        print(f"Last run:         {backup_last_run}")
    else:
        print("Last run:         never")
    
    if backup_last_success:
        print(f"Last success:     {backup_last_success}")
    else:
        print("Last success:     none")
    
    if backup_last_failure:
        print(f"Last failure:     {backup_last_failure}")

    print("-" * 50)
    print("")
    print("Certificate Expiry")
    print("-" * 50)
    if cert_summary.get("status") == "none":
        print("No certificates found.")
    elif cert_summary.get("status") == "unknown":
        print("Unable to parse certificate expiry.")
    else:
        print(f"Next expiry:      {cert_summary.get('message')}")
        if cert_summary.get("status") == "warn":
            print("Status:           WARNING (expires within threshold)")
    print("-" * 50)


def validate_cidr(cidr: str) -> str:
    try:
        net = ipaddress.ip_network(cidr, strict=False)
        if net.prefixlen == 0:
            raise ValueError("Refusing global allowlist (use a narrow CIDR, e.g., /32).")
        return str(net)
    except ValueError as e:
        if "Refusing global allowlist" in str(e):
            raise
        raise ValueError("Invalid CIDR. Example: 203.0.113.10/32")


def parse_ufw_allowlist_81(output: str) -> list:
    allowlist = []
    for line in output.splitlines():
        line = line.strip()
        if not line:
            continue
        if "81/tcp" in line and "ALLOW" in line:
            allowlist.append(line)
    return allowlist


def ufw_status() -> str:
    r = run_cmd(["ufw", "status"], timeout=10)
    return r.stdout.strip()


def cmd_admin_access(action: str, cidr: str = None) -> None:
    """
    Manage admin-plane access to port 81 (restricted by default).
    """
    require_root("admin-access")

    if not shutil.which("ufw"):
        print("Error: ufw not installed.")
        sys.exit(1)

    status_output = ufw_status()
    allowlist = parse_ufw_allowlist_81(status_output)
    sources = []
    for line in allowlist:
        parts = line.split()
        if "ALLOW" in parts and "IN" in parts:
            src_index = parts.index("IN") + 1
            if src_index < len(parts):
                sources.append(parts[src_index])

    if action == "status":
        if "Status: inactive" in status_output:
            print("UFW status: inactive (security group controls access).")
        if not allowlist:
            print("Admin UI port 81: restricted (no allowlist rules).")
        else:
            print("Admin UI port 81: allowlist active.")
            for line in allowlist:
                print(f"  - {line}")
        return

    if action == "enable":
        if not cidr:
            print("Error: --cidr is required for enable.")
            sys.exit(1)
        try:
            cidr = validate_cidr(cidr)
        except ValueError as e:
            print(f"Error: {e}")
            sys.exit(1)

        if cidr in sources:
            print(f"Admin UI allowlist already enabled for {cidr}.")
            return

        run_cmd(["ufw", "allow", "from", cidr, "to", "any", "port", "81", "proto", "tcp", "comment", "NPM Admin UI allowlist"], check=True)
        print(f"Admin UI allowlist enabled for {cidr}.")
        cmd_admin_access("status")
        return

    if action == "disable":
        if not allowlist:
            print("Admin UI allowlist already disabled.")
            return

        if any("Anywhere" in line for line in allowlist):
            run_cmd(["ufw", "--force", "delete", "allow", "81/tcp"], check=False)

        for src in sources:
            if src in ("Anywhere", "Anywhere (v6)"):
                continue
            run_cmd(["ufw", "--force", "delete", "allow", "from", src, "to", "any", "port", "81", "proto", "tcp"], check=False)

        print("Admin UI allowlist disabled.")
        cmd_admin_access("status")
        return

    print("Error: invalid admin-access action.")
    sys.exit(1)


def main():
    """Main entry point for npm-helper CLI."""
    parser = argparse.ArgumentParser(
        description="NPM Helper - Administrative commands for Nginx Proxy Manager",
        prog="npm-helper"
    )
    
    subparsers = parser.add_subparsers(
        dest="command",
        help="Available commands",
        required=True
    )
    
    # show-admin subcommand
    parser_show = subparsers.add_parser(
        "show-admin",
        help="Display current admin username and credentials location"
    )
    
    # rotate-admin subcommand
    parser_rotate = subparsers.add_parser(
        "rotate-admin",
        help="Generate and set a new admin password"
    )
    
    # status subcommand
    parser_status = subparsers.add_parser(
        "status",
        help="Show system and service status"
    )

    # cert-check subcommand
    subparsers.add_parser(
        "cert-check",
        help="Run certificate expiry checks"
    )

    # show-creds subcommand
    parser_creds = subparsers.add_parser(
        "show-creds",
        help="Display stored admin credentials (root only)"
    )
    parser_creds.add_argument(
        "--yes",
        action="store_true",
        help="Skip confirmation prompt"
    )

    # admin-access subcommand
    parser_admin_access = subparsers.add_parser(
        "admin-access",
        help="Manage admin UI allowlist for port 81"
    )
    parser_admin_access.add_argument(
        "action",
        choices=["enable", "disable", "status"],
        help="Enable, disable, or show admin UI access state"
    )
    parser_admin_access.add_argument(
        "--cidr",
        help="CIDR to allow (required for enable)"
    )

    # update-os subcommand
    subparsers.add_parser("update-os", help="Run a one-click OS update (apt-get update && apt-get upgrade)")

    # upgrade subcommand
    parser_upgrade = subparsers.add_parser("upgrade", help="Upgrade the NPM stack safely (backup-first)")
    parser_upgrade.add_argument(
        "--dry-run",
        action="store_true",
        help="Perform preflight checks and show planned steps"
    )

    # backup subcommand
    parser_backup = subparsers.add_parser("backup", help="Backup helper commands")
    backup_sub = parser_backup.add_subparsers(dest="backup_action", required=True)
    backup_sub.add_parser("verify", help="Verify the most recent backup archive")

    # restore subcommand
    parser_restore = subparsers.add_parser("restore", help="Restore a backup archive")
    parser_restore.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate archive contents without restoring"
    )
    parser_restore.add_argument(
        "backup_path",
        nargs="?",
        help="Backup archive path"
    )

    # diagnostics subcommand
    parser_diag = subparsers.add_parser("diagnostics", help="Collect non-sensitive diagnostics for troubleshooting")
    parser_diag.add_argument(
        "--json",
        action="store_true",
        help="Output machine-readable JSON only"
    )
    
    # Parse arguments
    args = parser.parse_args()
    
    # Execute the appropriate command
    if args.command == "show-admin":
        cmd_show_admin()
    elif args.command == "show-creds":
        cmd_show_creds(assume_yes=getattr(args, "yes", False))
    elif args.command == "rotate-admin":
        cmd_rotate_admin()
    elif args.command == "status":
        cmd_status()
    elif args.command == "cert-check":
        cmd_cert_check()
    elif args.command == "admin-access":
        cmd_admin_access(args.action, cidr=getattr(args, "cidr", None))
    elif args.command == "update-os":
        cmd_update_os()
    elif args.command == "upgrade":
        cmd_upgrade(dry_run=getattr(args, "dry_run", False))
    elif args.command == "backup":
        if args.backup_action == "verify":
            cmd_backup_verify()
        else:
            print("Error: invalid backup action.")
            sys.exit(1)
    elif args.command == "restore":
        cmd_restore(getattr(args, "backup_path", None), dry_run=getattr(args, "dry_run", False))
    elif args.command == "diagnostics":
        cmd_diagnostics(json_mode=getattr(args, "json", False))
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
