        print(f"Error: failed to run cert check: {e}")
        sys.exit(1)


def perform_upgrade_rollback(metadata: dict, dry_run: bool = False, reason: str = "manual") -> int:
    compose_dir = "/opt/npm"
    compose_file = Path(f"{compose_dir}/docker-compose.yml")
    previous_image = metadata.get("previous_image")
    backup_path = metadata.get("backup_path")

    if not previous_image or not backup_path:
        print("Error: rollback metadata is missing required fields (previous_image/backup_path).")
        return 1

    backup = Path(str(backup_path))
    if not backup.exists():
        print(f"Error: backup archive not found: {backup}")
        return 1

    if dry_run:
        print("Rollback dry run")
        print("=" * 50)
        print(f"Reason: {reason}")
        print(f"Would set compose image to: {previous_image}")
        print(f"Would restore backup: {backup}")
        print("Would run health checks after restore")
        return 0

    if not compose_file.exists():
        print(f"Error: compose file missing: {compose_file}")
        return 1

    print(f"Setting compose image back to: {previous_image}")
    if not set_compose_image(compose_file, previous_image):
        print("Error: failed to update compose image for rollback.")
        return 1

    print("Ensuring previous image is available...")
    pull = run_cmd(["docker", "pull", previous_image], timeout=1800)
    if pull.returncode != 0:
        inspect = run_cmd(["docker", "image", "inspect", previous_image], timeout=20)
        if inspect.returncode != 0:
            print("Error: failed to pull previous image and it is not available locally.")
            return 1

    print(f"Restoring known-good backup: {backup}")
    restore = run_cmd(["/usr/local/bin/npm-restore", str(backup)], timeout=3600)
    if restore.stdout.strip():
        print(restore.stdout.strip())
    if restore.stderr.strip():
        print(restore.stderr.strip())
    if restore.returncode != 0:
        print("Error: npm-restore failed during rollback.")
        return 1

    print("Running rollback health check...")
    health = check_npm_health(compose_dir, timeout_seconds=90)
    if not health.get("ok"):
        print("Error: rollback completed but health checks failed.")
        print(f"Container state={health.get('container_state')} http81={health.get('http_81')} httpApi={health.get('http_api')}")
        return 1

    metadata["status"] = "rolled_back"
    metadata["rolled_back_at"] = datetime.utcnow().isoformat() + "Z"
    write_state_json(LAST_ATTEMPT_PATH, metadata)
    write_state_json(LAST_KNOWN_GOOD_PATH, metadata)
    print("Rollback completed successfully.")
    return 0


def cmd_upgrade(dry_run: bool = False, auto_rollback: bool = False) -> None:
    """
    Safely upgrade the NPM stack using the existing compose file pins.
    """
    require_root("upgrade")

    compose_dir = "/opt/npm"
    compose_file = Path(f"{compose_dir}/docker-compose.yml")
    backup_dir = get_backup_dir()
    min_free_bytes = 1024 * 1024 * 1024  # 1 GiB
    steps = [
        "Preflight checks",
        "Run npm-backup",
        "docker compose pull",
        "Restart npm.service",
        "Post-upgrade health check (container + HTTP + /api)",
        "Persist rollback metadata",
    ]

    print("NPM Upgrade (safe, backup-first)")
    print("=" * 50)
    if dry_run:
        print("Dry run mode: no changes will be made.")
        print("")
        print(f"Auto rollback on health check failure: {'enabled' if auto_rollback else 'disabled'}")
        print("")

    # Preflight checks
    issues = []
    if not compose_file.exists():
        issues.append(f"compose file missing: {compose_file}")

    try:
        docker_state = run_cmd(["systemctl", "is-active", "docker"], timeout=5)
        if docker_state.returncode != 0 or docker_state.stdout.strip() != "active":
            issues.append("docker service is not active")
    except Exception:
        issues.append("unable to check docker service status")

    if not Path("/usr/local/bin/npm-backup").exists():
        issues.append("npm-backup not found")

    if not Path(backup_dir).exists():
        issues.append(f"backup dir not found: {backup_dir}")
    elif not os.access(backup_dir, os.W_OK):
        issues.append(f"backup dir not writable: {backup_dir}")
    else:
        try:
            backup_usage = shutil.disk_usage(backup_dir)
            if backup_usage.free < min_free_bytes:
                issues.append(f"low disk space in backup dir (less than 1GiB free): {backup_dir}")
        except Exception:
            issues.append(f"unable to check disk space in backup dir: {backup_dir}")

    try:
        usage = shutil.disk_usage("/")
        if usage.free < min_free_bytes:
            issues.append("low disk space on / (less than 1GiB free)")
    except Exception:
        issues.append("unable to check disk space on /")

    if issues:
        print("Preflight checks failed:")
        for issue in issues:
            print(f" - {issue}")
        sys.exit(1)

    if dry_run:
        print("Planned steps:")
        for step in steps:
            print(f" - {step}")
        sys.exit(0)

    backup_path = None
    previous_image = get_compose_image(compose_file)
    print("Running safety backup...")
    backup_proc = run_cmd(["/usr/local/bin/npm-backup"], timeout=1800)
    if backup_proc.returncode != 0:
        print("Error: backup failed; aborting upgrade.")
        if backup_proc.stdout:
            print(backup_proc.stdout.strip())
        if backup_proc.stderr:
            print(backup_proc.stderr.strip())
        sys.exit(1)
    if backup_proc.stdout.strip():
        print(backup_proc.stdout.strip())
    for line in backup_proc.stdout.splitlines():
        if "NORTHSTAR_BACKUP" in line and "path=" in line:
            backup_path = line.split("path=", 1)[1].strip().split()[0]
            break
    if not backup_path:
        backup_path = "unknown"

    attempt = {
        "status": "in_progress",
        "started_at": datetime.utcnow().isoformat() + "Z",
        "compose_file": str(compose_file),
        "backup_path": backup_path,
        "previous_image": previous_image,
        "target_image": get_compose_image(compose_file),
        "auto_rollback": bool(auto_rollback),
    }
    write_state_json(LAST_ATTEMPT_PATH, attempt)

    print("Pulling container images...")
    pull_proc = run_cmd(["docker", "compose", "pull"], cwd=compose_dir, timeout=1800)
    if pull_proc.returncode != 0:
        print("Error: docker compose pull failed.")
        if pull_proc.stdout:
            print(pull_proc.stdout.strip())
        if pull_proc.stderr:
            print(pull_proc.stderr.strip())
        sys.exit(1)

    print("Restarting NPM stack...")
    restart_proc = run_cmd(["systemctl", "restart", "npm.service"], timeout=300)
    if restart_proc.returncode != 0:
        print("Error: failed to restart npm.service.")
        attempt["status"] = "failed_restart"
        attempt["finished_at"] = datetime.utcnow().isoformat() + "Z"
        write_state_json(LAST_ATTEMPT_PATH, attempt)
        sys.exit(1)

    print("Post-upgrade health check...")
    health = check_npm_health(compose_dir, timeout_seconds=90)
    attempt["health"] = {
        "container_state": health.get("container_state"),
        "http_81": health.get("http_81"),
        "http_api": health.get("http_api"),
    }

    if not health.get("ok"):
        attempt["status"] = "failed_healthcheck"
        attempt["finished_at"] = datetime.utcnow().isoformat() + "Z"
        write_state_json(LAST_ATTEMPT_PATH, attempt)
        print("Error: health check did not confirm NPM is running.")
        print(f"Container state={health.get('container_state')} http81={health.get('http_81')} httpApi={health.get('http_api')}")
        if auto_rollback:
            print("Auto-rollback enabled; attempting rollback...")
            rollback_rc = perform_upgrade_rollback(attempt, dry_run=False, reason="upgrade-healthcheck-failed")
            sys.exit(1 if rollback_rc == 0 else 2)
        print("Rollback command:")
        print("  sudo npm-helper rollback")
        sys.exit(1)

    print("")
    attempt["status"] = "success"
    attempt["finished_at"] = datetime.utcnow().isoformat() + "Z"
    attempt["target_image"] = get_compose_image(compose_file)
    write_state_json(LAST_ATTEMPT_PATH, attempt)
    write_state_json(LAST_KNOWN_GOOD_PATH, attempt)
    print("Upgrade completed.")
    print(f"Backup used: {backup_path}")
    print("Rollback command:")
    print("  sudo npm-helper rollback")
    sys.exit(0)


def cmd_rollback(dry_run: bool = False, metadata_file: str = "") -> None:
    """
    Roll back to last-known-good metadata captured by upgrade workflows.
    """
    require_root("rollback")
    metadata_path = metadata_file.strip() if metadata_file else LAST_ATTEMPT_PATH
    metadata = read_state_json(metadata_path)
    if not metadata:
        metadata = read_state_json(LAST_KNOWN_GOOD_PATH)
        metadata_path = LAST_KNOWN_GOOD_PATH

    if not metadata:
        print("Error: no rollback metadata found.")
        print(f"Expected: {LAST_ATTEMPT_PATH} or {LAST_KNOWN_GOOD_PATH}")
        sys.exit(1)

    print("NPM Rollback")
    print("=" * 50)
    print(f"Metadata source: {metadata_path}")
    rc = perform_upgrade_rollback(metadata, dry_run=dry_run, reason="manual")
    sys.exit(rc)


def cmd_backup_verify() -> None:
    """
    Verify the most recent backup archive for expected contents.
    """
    require_root("backup verify")
    backup_dir = Path(get_backup_dir())
    min_size_bytes = 1024 * 1024  # 1 MiB
    retention = get_backup_retention()

    print("NPM Backup Verification")
    print("=" * 50)

    if not backup_dir.exists():
        print(f"Backup directory not found: {backup_dir}")
        print("Summary: RED")
        sys.exit(1)

    backups = sorted(backup_dir.glob("npm-*.tar.gz"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not backups:
        print("No backup archives found.")
        print("Summary: RED")
        sys.exit(1)

    latest = backups[0]
    warnings = []
    errors = []

    if latest.stat().st_size < min_size_bytes:
        errors.append(f"backup file is smaller than expected ({latest.stat().st_size} bytes)")

    tar_list = run_cmd(["tar", "-tzf", str(latest)], timeout=30)
    if tar_list.returncode != 0:
        errors.append("unable to read backup archive (tar -tzf failed)")
    else:
        lines = tar_list.stdout.splitlines()
        has_data = any(line.startswith("opt/npm/data/") for line in lines)
        has_letsencrypt = any(line.startswith("opt/npm/letsencrypt/") for line in lines)

        if not has_data:
            errors.append("missing opt/npm/data in archive")
        if not has_letsencrypt:
            warnings.append("missing opt/npm/letsencrypt in archive (no certs yet?)")

    if retention and len(backups) > retention:
        warnings.append(f"backup count {len(backups)} exceeds retention setting {retention}")

    print(f"Latest backup: {latest}")
    print(f"Size: {latest.stat().st_size} bytes")
    if errors:
        print("Issues:")
        for issue in errors:
            print(f" - {issue}")
    if warnings:
        print("Warnings:")
        for warn in warnings:
            print(f" - {warn}")

    if errors:
        print("Summary: RED")
        sys.exit(1)
    if warnings:
        print("Summary: YELLOW")
        sys.exit(2)

    print("Summary: GREEN")
    sys.exit(0)


def verify_database_in_archive(backup: Path) -> dict:
    """Extract database.sqlite from archive to a temp dir and run integrity checks."""
    result = {
        "integrity_check": None,
        "user_table_exists": None,
        "user_count": None,
        "proxy_host_table_exists": None,
        "errors": [],
    }
    tmp_dir = None
    try:
        tmp_dir = tempfile.mkdtemp(prefix="npm-db-verify-")
        extract = run_cmd(
            ["tar", "-xzf", str(backup), "-C", tmp_dir, "opt/npm/data/database.sqlite"],
            timeout=30,
        )
        db_path = Path(tmp_dir) / "opt" / "npm" / "data" / "database.sqlite"
        if extract.returncode != 0 or not db_path.exists():
            result["errors"].append("could not extract database.sqlite from archive")
            return result

        conn = sqlite3.connect(str(db_path), timeout=5)
        try:
            cur = conn.cursor()

            cur.execute("PRAGMA integrity_check;")
            ic = cur.fetchone()
            ic_val = ic[0] if ic else "unknown"
            result["integrity_check"] = ic_val
            if ic_val != "ok":
                result["errors"].append(f"PRAGMA integrity_check returned: {ic_val}")

            cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='user';")
            result["user_table_exists"] = cur.fetchone() is not None
            if result["user_table_exists"]:
                cur.execute('SELECT COUNT(*) FROM "user";')
                row = cur.fetchone()
                result["user_count"] = row[0] if row else 0
                if result["user_count"] == 0:
                    result["errors"].append("user table exists but contains 0 rows")
            else:
                result["errors"].append("user table not found in database")

            cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='proxy_host';")
            result["proxy_host_table_exists"] = cur.fetchone() is not None
            if not result["proxy_host_table_exists"]:
                result["errors"].append("proxy_host table not found in database")
        finally:
            conn.close()
    except Exception as e:
        result["errors"].append(f"database verification error: {e}")
    finally:
        if tmp_dir:
            shutil.rmtree(tmp_dir, ignore_errors=True)
    return result


def analyze_backup_archive(backup: Path) -> dict:
    min_size_bytes = 1024 * 1024  # 1 MiB
    errors = []
    warnings = []
    targets = []
    entries_count = 0

    if not backup.exists():
        errors.append(f"backup archive not found: {backup}")
        return {"errors": errors, "warnings": warnings, "targets": targets, "entries_count": entries_count}

    if backup.stat().st_size < min_size_bytes:
        errors.append(f"backup file is smaller than expected ({backup.stat().st_size} bytes)")

    tar_list = run_cmd(["tar", "-tzf", str(backup)], timeout=30)
    if tar_list.returncode != 0:
        errors.append("unable to read backup archive (tar -tzf failed)")
        return {"errors": errors, "warnings": warnings, "targets": targets, "entries_count": entries_count}

    lines = [line.strip() for line in tar_list.stdout.splitlines() if line.strip()]
    entries_count = len(lines)
    has_data = any(line.startswith("opt/npm/data/") for line in lines)
    has_letsencrypt = any(line.startswith("opt/npm/letsencrypt/") for line in lines)
    if has_data:
        targets.append("/opt/npm/data")
    if has_letsencrypt:
        targets.append("/opt/npm/letsencrypt")
    if not has_data:
        errors.append("missing opt/npm/data in archive")
    if not has_letsencrypt:
        warnings.append("missing opt/npm/letsencrypt in archive (no certs yet?)")

    return {
        "errors": errors,
        "warnings": warnings,
        "targets": targets,
        "entries_count": entries_count,
    }


def cmd_restore(
    backup_path: str,
    dry_run: bool = False,
    verify: bool = False,
    report_file: str = RESTORE_VERIFY_REPORT_DEFAULT,
) -> None:
    """
    Restore a backup archive. Dry-run validates without changes.
    """
    require_root("restore")
    if not backup_path:
        print("Error: backup archive path required.")
        sys.exit(1)
    backup = Path(backup_path)
    start = time.time()
    analyzed = analyze_backup_archive(backup)
    errors = analyzed.get("errors", [])
    warnings = analyzed.get("warnings", [])
    targets = analyzed.get("targets", [])

    if verify:
        db_checks = verify_database_in_archive(backup)
        db_errors = db_checks.get("errors", [])
        errors.extend(db_errors)

        report = {
            "generated_at_utc": datetime.utcnow().isoformat() + "Z",
            "mode": "restore_verify",
            "source": "npm-helper",
            "backup_path": str(backup),
            "backup_size_bytes": backup.stat().st_size if backup.exists() else None,
            "entries_count": analyzed.get("entries_count", 0),
            "targets": targets,
            "errors": errors,
            "warnings": warnings,
            "database_checks": {
                "integrity_check": db_checks.get("integrity_check"),
                "user_table_exists": db_checks.get("user_table_exists"),
                "user_count": db_checks.get("user_count"),
                "proxy_host_table_exists": db_checks.get("proxy_host_table_exists"),
            },
            "status": "pass" if not errors else "fail",
            "duration_seconds": round(time.time() - start, 3),
        }
        report_path = Path(report_file)
        report_path.parent.mkdir(parents=True, exist_ok=True)
        with open(report_path, "w", encoding="utf-8") as f:
            json.dump(report, f, indent=2, sort_keys=True)
            f.write("\n")
        try:
            os.chmod(report_path, 0o640)
        except Exception:
            pass

        print("Restore verification report")
        print("=" * 50)
        print(f"Backup archive: {backup}")
        print(f"Report file: {report_path}")
        if targets:
            print("Targets detected:")
            for target in targets:
                print(f" - {target}")
        print("Database checks:")
        print(f"  Integrity:    {db_checks.get('integrity_check', 'N/A')}")
        print(f"  User table:   {'present' if db_checks.get('user_table_exists') else 'missing'}"
              f" ({db_checks.get('user_count', 0)} rows)")
        print(f"  Proxy hosts:  {'present' if db_checks.get('proxy_host_table_exists') else 'missing'}")
        if warnings:
            print("Warnings:")
            for warn in warnings:
                print(f" - {warn}")
        if errors:
            print("Issues:")
            for issue in errors:
                print(f" - {issue}")
            print("Summary: RED")
            sys.exit(1)
        print("Summary: GREEN")
        sys.exit(0)

    if dry_run:
        if errors:
            print("Error: backup archive does not contain expected NPM paths or failed validation.")
            for issue in errors:
                print(f" - {issue}")
            sys.exit(1)

        print("Restore dry run")
        print("=" * 50)
        print(f"Backup archive: {backup}")
        print("Would restore:")
        for target in targets:
            print(f" - {target}")
        sys.exit(0)

    if errors:
        print("Error: restore pre-checks failed:")
        for issue in errors:
            print(f" - {issue}")
        sys.exit(1)

    result = subprocess.run(["/usr/local/bin/npm-restore", str(backup)], check=False)
    sys.exit(result.returncode)

def parse_status_line(line: str):
    """
    Parse status files written by preflight/postinit scripts.
    Expected formats:
      OK <timestamp>
      FAIL <timestamp> reason=<enum>
    """
    if not line:
        return None
    parts = line.split()
    if len(parts) >= 2 and parts[0] in ("OK", "FAIL"):
        status = "ok" if parts[0] == "OK" else "fail"
        ts = parts[1]
        reason = None
        for p in parts[2:]:
            if p.startswith("reason="):
                reason = p.split("=", 1)[1]
                break
        out = {"status": status, "timestamp": ts}
        if reason:
            out["reason"] = reason
        return out
    return {"raw": line}


def systemd_unit_status(unit: str, errors: list):
    info = {"unit": unit}
    try:
        r_active = run_cmd(["systemctl", "is-active", unit], timeout=5)
        info["active"] = r_active.stdout.strip() if r_active.stdout.strip() else "unknown"
        r_enabled = run_cmd(["systemctl", "is-enabled", unit], timeout=5)
        info["enabled"] = r_enabled.stdout.strip() if r_enabled.stdout.strip() else "unknown"
    except FileNotFoundError:
        errors.append(f"systemctl_not_found:{unit}")
        info["active"] = "unknown"
        info["enabled"] = "unknown"
    except Exception as e:
        errors.append(f"systemctl_error:{unit}:{type(e).__name__}")
        info["active"] = "unknown"
        info["enabled"] = "unknown"
    return info


def cmd_diagnostics(json_mode: bool = False):
    """
    Gather non-sensitive diagnostics for support and troubleshooting.
    """
    errors = []
    core_errors = []

    # Lifecycle markers
    preflight = parse_status_line(read_sentinel_file(PREFLIGHT_STATUS))
    postinit = parse_status_line(read_sentinel_file(POSTINIT_STATUS))
    init_marker = Path(INIT_MARKER_FILE)
    init_info = {"status": "complete" if init_marker.exists() else "incomplete"}
    if init_marker.exists():
        try:
            init_info["timestamp"] = time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(init_marker.stat().st_mtime))
        except Exception:
            pass

    # Systemd statuses (core)
    units = [
        "npm.service",
        "npm-preflight.service",
        "npm-init.service",
        "npm-postinit.service",
        "npm-backup.timer",
        "npm-backup.service",
        "npm-cert-check.timer",
        "npm-cert-check.service",
    ]
    unit_statuses = []
    for u in units:
        st = systemd_unit_status(u, errors)
        unit_statuses.append(st)
        if st.get("active") == "unknown" and st.get("enabled") == "unknown":
            core_errors.append(f"systemd_status_unavailable:{u}")

    # Disk usage (core)
    disk = {}
    try:
        du_root = shutil.disk_usage("/")
        disk["root"] = {
            "path": "/",
            "total_bytes": du_root.total,
            "used_bytes": du_root.used,
            "free_bytes": du_root.free,
            "used_percent": round((du_root.used / du_root.total) * 100, 2) if du_root.total else None,
        }
    except Exception as e:
        core_errors.append(f"disk_usage_error_root:{type(e).__name__}")

    try:
        du_backups = shutil.disk_usage(BACKUP_DIR)
        disk["backups"] = {
            "path": BACKUP_DIR,
            "total_bytes": du_backups.total,
            "used_bytes": du_backups.used,
            "free_bytes": du_backups.free,
            "used_percent": round((du_backups.used / du_backups.total) * 100, 2) if du_backups.total else None,
        }
    except FileNotFoundError:
        disk["backups"] = {"path": BACKUP_DIR, "error": "not_found"}
    except Exception as e:
        errors.append(f"disk_usage_error_backups:{type(e).__name__}")

    # CloudWatch agent status (best-effort)
    cw = {"service": "amazon-cloudwatch-agent.service"}
    cw.update(systemd_unit_status("amazon-cloudwatch-agent.service", errors))

    # IAM availability (best-effort, no AWS SDK; IMDSv2 attempt with short timeouts)
    iam = {"available": "unknown", "method": "imds"}
    try:
        if not shutil.which("curl"):
            raise FileNotFoundError()
        # token
        token = run_cmd(
            ["curl", "-sS", "-m", "1", "-X", "PUT", "http://169.254.169.254/latest/api/token",
             "-H", "X-aws-ec2-metadata-token-ttl-seconds: 60"],
            timeout=2,
        )
        if token.returncode == 0 and token.stdout.strip():
            t = token.stdout.strip()
            role = run_cmd(
                ["curl", "-sS", "-m", "1", "-H", f"X-aws-ec2-metadata-token: {t}",
                 "http://169.254.169.254/latest/meta-data/iam/security-credentials/"],
                timeout=2,
            )
            iam["available"] = bool(role.returncode == 0 and role.stdout.strip())
        else:
            iam["available"] = "unknown"
    except FileNotFoundError:
        iam["available"] = "unknown"
    except Exception:
        iam["available"] = "unknown"

    # NPM container health (best-effort)
    npm_container = {"status": "unknown", "containers": []}
    try:
        r = run_cmd(["docker", "compose", "ps", "--format", "json"], cwd="/opt/npm", timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            for line in r.stdout.strip().splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                    npm_container["containers"].append(
                        {
                            "name": obj.get("Name"),
                            "service": obj.get("Service"),
                            "state": obj.get("State"),
                            "health": obj.get("Health"),
                        }
                    )
                except Exception:
                    continue
            # derive overall status
            if any(c.get("state") == "running" for c in npm_container["containers"]):
                npm_container["status"] = "running"
            elif npm_container["containers"]:
                npm_container["status"] = "not_running"
            else:
                npm_container["status"] = "unknown"
        else:
            npm_container["status"] = "not_found"
    except FileNotFoundError:
        npm_container["status"] = "docker_not_found"
    except Exception as e:
        errors.append(f"docker_compose_ps_error:{type(e).__name__}")

    result = {
        "product": "Nginx Proxy Manager (NPM) for AWS",
        "vendor": "Northstar Cloud Solutions LLC",
        "lifecycle": {
            "preflight": preflight,
            "init": init_info,
            "postinit": postinit,
        },
        "systemd": {"units": unit_statuses},
        "disk": disk,
        "cloudwatch": {"agent": cw, "iam_available": iam["available"], "iam_method": iam["method"]},
        "npm": npm_container,
        "errors": errors,
    }

    exit_code = 0
    if core_errors:
        result.setdefault("errors", []).extend(core_errors)
        exit_code = 1

    if json_mode:
        sys.stdout.write(json.dumps(result, separators=(",", ":"), sort_keys=True) + "\n")
        sys.exit(exit_code)

    # Human output (keep concise)
    print("NPM Diagnostics")
    print("=" * 50)
    print(f"Init: {init_info.get('status')}")
    if preflight:
        print(f"Preflight: {preflight}")
    if postinit:
        print(f"Post-init: {postinit}")
    print("")
    for u in unit_statuses:
        print(f"{u['unit']}: active={u.get('active')} enabled={u.get('enabled')}")
    if disk.get("root"):
        print(f"Disk / used_percent={disk['root'].get('used_percent')}%")
    if disk.get("backups") and isinstance(disk["backups"], dict) and disk["backups"].get("used_percent") is not None:
        print(f"Disk {BACKUP_DIR} used_percent={disk['backups'].get('used_percent')}%")
    print(f"CloudWatch agent active={cw.get('active')} enabled={cw.get('enabled')} iam_available={iam.get('available')}")
    print(f"NPM containers status={npm_container.get('status')}")
    if errors:
        print("Errors:")
        for e in errors:
            print(f" - {e}")
    sys.exit(exit_code)


