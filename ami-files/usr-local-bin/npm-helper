def read_sentinel_file(filepath: str) -> str:
    """
    Read the contents of a sentinel file.
    
    Args:
        filepath: Path to the sentinel file
    
    Returns:
        Contents of the file, or None if file doesn't exist or is unreadable
    """
    try:
        sentinel = Path(filepath)
        if sentinel.exists() and sentinel.is_file():
            return sentinel.read_text().strip()
    except Exception:
        pass
    return None


def cmd_status():
    """
    Display system and service status.
    
    Shows:
    - Docker service status
    - npm service status
    - NPM container status
    - Backup status (last run, last success, last failure)
    
    Exits with code 0 unless an unexpected error occurs.
    """
    status_info = {}
    unit_info = []
    
    # Check Docker service status
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "docker"],
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            status_info["docker"] = result.stdout.strip()
        else:
            status_info["docker"] = "inactive"
    except Exception as e:
        status_info["docker"] = f"unknown (error: {e})"
    
    # Check npm service status
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "npm"],
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            status_info["npm"] = result.stdout.strip()
        else:
            status_info["npm"] = "inactive"
    except Exception as e:
        status_info["npm"] = f"unknown (error: {e})"
    
    # Check NPM container status
    container_status = "unknown"
    try:
        result = subprocess.run(
            ["docker", "compose", "ps", "--format", "json"],
            cwd="/opt/npm",
            capture_output=True,
            text=True,
            timeout=10
        )
        if result.returncode == 0 and result.stdout.strip():
            # Parse JSON output to determine container state
            import json
            lines = result.stdout.strip().split('\n')
            for line in lines:
                if line.strip():
                    try:
                        container = json.loads(line)
                        state = container.get("State", "unknown")
                        if state == "running":
                            container_status = "running"
                            break
                        elif state in ["exited", "stopped"]:
                            container_status = "exited"
                    except json.JSONDecodeError:
                        pass
        else:
            container_status = "not found"
    except FileNotFoundError:
        container_status = "docker compose not available"
    except Exception as e:
        container_status = f"error checking ({e})"
    
    status_info["container"] = container_status

    # Systemd unit status (core + timers)
    units = ["npm.service", "npm-init.service", "npm-backup.timer", "npm-cert-check.timer"]
    for unit in units:
        info = {"unit": unit, "active": "unknown", "enabled": "unknown"}
        try:
            active = run_cmd(["systemctl", "is-active", unit], timeout=5)
            enabled = run_cmd(["systemctl", "is-enabled", unit], timeout=5)
            info["active"] = active.stdout.strip() if active.stdout.strip() else "unknown"
            info["enabled"] = enabled.stdout.strip() if enabled.stdout.strip() else "unknown"
        except Exception as e:
            info["error"] = str(e)
        unit_info.append(info)
    
    # Find last backup file
    last_backup_file = "none found"
    try:
        backup_dir = Path(BACKUP_DIR)
        if backup_dir.exists() and backup_dir.is_dir():
            backup_files = list(backup_dir.glob("npm-*.tar.gz"))
            if backup_files:
                # Sort by modification time, most recent first
                backup_files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
                last_backup_file = backup_files[0].name
    except Exception as e:
        last_backup_file = f"error checking ({e})"
    
    # Read backup status from sentinel files
    backup_last_run = read_sentinel_file(SENTINEL_LAST_RUN)
    backup_last_success = read_sentinel_file(SENTINEL_LAST_SUCCESS)
    backup_last_failure = read_sentinel_file(SENTINEL_LAST_FAILURE)

    # Read first-boot status
    preflight_status = read_sentinel_file(PREFLIGHT_STATUS)
    postinit_status = read_sentinel_file(POSTINIT_STATUS)
    init_complete = Path(INIT_MARKER_FILE).exists()
    
    # Admin UI allowlist (UFW)
    admin_access_lines = []
    try:
        if shutil.which("ufw"):
            status_output = ufw_status()
            allowlist = parse_ufw_allowlist_81(status_output)
            if "Status: inactive" in status_output:
                admin_access_lines.append("UFW: inactive (security group controls access)")
            if not allowlist:
                admin_access_lines.append("Admin UI port 81: restricted (no allowlist rules)")
            else:
                admin_access_lines.append("Admin UI port 81: allowlist active")
                for line in allowlist:
                    admin_access_lines.append(f"  - {line}")
        else:
            admin_access_lines.append("UFW: not installed")
    except Exception as e:
        admin_access_lines.append(f"Admin UI access: unknown ({e})")

    # Certificate expiry summary
    threshold = read_config_int(CERT_CHECK_CONFIG, "cert-check", "threshold_days", DEFAULT_CERT_THRESHOLD_DAYS)
    cert_summary = get_cert_expiry_summary(threshold)

    # Print status summary
    print("NPM System Status")
    print("=" * 50)
    print(f"Docker service:   {status_info['docker']}")
    print(f"npm service:      {status_info['npm']}")
    print(f"NPM container:    {status_info['container']}")
    print("")
    print("Systemd Units")
    print("-" * 50)
    for info in unit_info:
        print(f"{info['unit']}: active={info.get('active')} enabled={info.get('enabled')}")
    print("=" * 50)
    print("")
    print("Initialization Status")
    print("-" * 50)
    if preflight_status:
        print(f"Preflight:       {preflight_status}")
    else:
        print("Preflight:       not yet run")
    print(f"Init:            {'complete' if init_complete else 'incomplete'}")
    if postinit_status:
        print(f"Post-init:       {postinit_status}")
    else:
        print("Post-init:       not yet run")
    print("-" * 50)
    print("")
    print("Admin UI Access")
    print("-" * 50)
    for line in admin_access_lines:
        print(line)
    print("-" * 50)

    print("")
    print("Backup Status")
    print("-" * 50)
    print(f"Last backup file: {last_backup_file}")
    
    if backup_last_run:
        print(f"Last run:         {backup_last_run}")
    else:
        print("Last run:         never")
    
    if backup_last_success:
        print(f"Last success:     {backup_last_success}")
    else:
        print("Last success:     none")
    
    if backup_last_failure:
        print(f"Last failure:     {backup_last_failure}")

    print("-" * 50)
    print("")
    print("Certificate Expiry")
    print("-" * 50)
    if cert_summary.get("status") == "none":
        print("No certificates found.")
    elif cert_summary.get("status") == "unknown":
        print("Unable to parse certificate expiry.")
    else:
        print(f"Next expiry:      {cert_summary.get('message')}")
        if cert_summary.get("status") == "warn":
            print("Status:           WARNING (expires within threshold)")
    print("-" * 50)


def validate_cidr(cidr: str) -> str:
    try:
        net = ipaddress.ip_network(cidr, strict=False)
        if net.prefixlen == 0:
            raise ValueError("Refusing global allowlist (use a narrow CIDR, e.g., /32).")
        return str(net)
    except ValueError as e:
        if "Refusing global allowlist" in str(e):
            raise
        raise ValueError("Invalid CIDR. Example: 203.0.113.10/32")


def parse_ufw_allowlist_81(output: str) -> list:
    allowlist = []
    for line in output.splitlines():
        line = line.strip()
        if not line:
            continue
        if "81/tcp" in line and "ALLOW" in line:
            allowlist.append(line)
    return allowlist


def ufw_status() -> str:
    r = run_cmd(["ufw", "status"], timeout=10)
    return r.stdout.strip()


def cmd_admin_access(action: str, cidr: str = None) -> None:
    """
    Manage admin-plane access to port 81 (restricted by default).
    """
    require_root("admin-access")

    if not shutil.which("ufw"):
        print("Error: ufw not installed.")
        sys.exit(1)

    status_output = ufw_status()
    allowlist = parse_ufw_allowlist_81(status_output)
    sources = []
    for line in allowlist:
        parts = line.split()
        if "ALLOW" in parts and "IN" in parts:
            src_index = parts.index("IN") + 1
            if src_index < len(parts):
                sources.append(parts[src_index])

    if action == "status":
        if "Status: inactive" in status_output:
            print("UFW status: inactive (security group controls access).")
        if not allowlist:
            print("Admin UI port 81: restricted (no allowlist rules).")
        else:
            print("Admin UI port 81: allowlist active.")
            for line in allowlist:
                print(f"  - {line}")
        return

    if action == "enable":
        if not cidr:
            print("Error: --cidr is required for enable.")
            sys.exit(1)
        try:
            cidr = validate_cidr(cidr)
        except ValueError as e:
            print(f"Error: {e}")
            sys.exit(1)

        if cidr in sources:
            print(f"Admin UI allowlist already enabled for {cidr}.")
            return

        run_cmd(["ufw", "allow", "from", cidr, "to", "any", "port", "81", "proto", "tcp", "comment", "NPM Admin UI allowlist"], check=True)
        print(f"Admin UI allowlist enabled for {cidr}.")
        cmd_admin_access("status")
        return

    if action == "disable":
        if not allowlist:
            print("Admin UI allowlist already disabled.")
            return

        if any("Anywhere" in line for line in allowlist):
            run_cmd(["ufw", "--force", "delete", "allow", "81/tcp"], check=False)

        for src in sources:
            if src in ("Anywhere", "Anywhere (v6)"):
                continue
            run_cmd(["ufw", "--force", "delete", "allow", "from", src, "to", "any", "port", "81", "proto", "tcp"], check=False)

        print("Admin UI allowlist disabled.")
        cmd_admin_access("status")
        return

    print("Error: invalid admin-access action.")
    sys.exit(1)


def cmd_health_report(json_mode: bool = False) -> None:
    """Unified health assessment with pass/warn/fail verdict per subsystem."""
    checks = []

    def add_check(name, status, detail=""):
        checks.append({"check": name, "status": status, "detail": detail})

    # 1. Docker service
    try:
        r = run_cmd(["systemctl", "is-active", "docker"], timeout=5)
        state = r.stdout.strip()
        add_check("docker_service", "pass" if state == "active" else "fail", state)
    except Exception as e:
        add_check("docker_service", "fail", str(e))

    # 2. NPM service
    try:
        r = run_cmd(["systemctl", "is-active", "npm"], timeout=5)
        state = r.stdout.strip()
        add_check("npm_service", "pass" if state == "active" else "fail", state)
    except Exception as e:
        add_check("npm_service", "fail", str(e))

    # 3. NPM container
    try:
        r = run_cmd(["docker", "compose", "ps", "--format", "json"], cwd="/opt/npm", timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            container_running = False
            for line in r.stdout.strip().split("\n"):
                if line.strip():
                    try:
                        c = json.loads(line)
                        if c.get("State") == "running":
                            container_running = True
                            break
                    except json.JSONDecodeError:
                        pass
            add_check("npm_container", "pass" if container_running else "fail",
                       "running" if container_running else "not running")
        else:
            add_check("npm_container", "fail", "not found")
    except Exception as e:
        add_check("npm_container", "fail", str(e))

    # 4. Init completion
    init_ok = Path(INIT_MARKER_FILE).exists()
    add_check("init_completion", "pass" if init_ok else "fail",
              "complete" if init_ok else "incomplete")

    # 5. Last backup
    sentinel_success = read_sentinel_file(SENTINEL_LAST_SUCCESS)
    sentinel_failure = read_sentinel_file(SENTINEL_LAST_FAILURE)
    if sentinel_success:
        try:
            ts_str = sentinel_success.split()[0] if sentinel_success else ""
            last_success_dt = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
            age_hours = (datetime.now(last_success_dt.tzinfo) - last_success_dt).total_seconds() / 3600
            if age_hours <= 26:
                add_check("last_backup", "pass", f"success {age_hours:.1f}h ago")
            else:
                add_check("last_backup", "warn", f"success {age_hours:.1f}h ago (>26h)")
        except Exception:
            add_check("last_backup", "pass", sentinel_success)
    elif sentinel_failure:
        add_check("last_backup", "fail", f"last run was failure: {sentinel_failure}")
    else:
        add_check("last_backup", "fail", "no backup has run")

    # 6. Restore verification
    rv_data = read_state_json(RESTORE_VERIFY_REPORT_DEFAULT)
    if rv_data:
        rv_status = rv_data.get("status", "unknown")
        rv_ts = rv_data.get("generated_at_utc", "")
        stale = False
        try:
            rv_dt = datetime.fromisoformat(rv_ts.replace("Z", "+00:00"))
            age_h = (datetime.now(rv_dt.tzinfo) - rv_dt).total_seconds() / 3600
            stale = age_h > 48
        except Exception:
            pass
        if rv_status == "pass" and not stale:
            add_check("restore_verification", "pass", rv_status)
        elif rv_status == "fail":
            add_check("restore_verification", "fail", rv_status)
        else:
            add_check("restore_verification", "warn",
                       f"{rv_status} (stale >48h)" if stale else rv_status)
    else:
        add_check("restore_verification", "fail", "no verification report found")

    # 7. Certificate expiry
    threshold = read_config_int(CERT_CHECK_CONFIG, "cert-check", "threshold_days",
                                DEFAULT_CERT_THRESHOLD_DAYS)
    cert_summary = get_cert_expiry_summary(threshold)
    cert_status_str = cert_summary.get("status", "none")
    cert_days = cert_summary.get("days_remaining", None)
    if cert_status_str == "none":
        add_check("certificate_expiry", "pass", "no certificates managed")
    elif cert_status_str == "unknown":
        add_check("certificate_expiry", "warn", "unable to parse certificate expiry")
    elif cert_days is not None and cert_days <= 7:
        add_check("certificate_expiry", "fail", f"{cert_days}d remaining")
    elif cert_status_str == "warn":
        add_check("certificate_expiry", "warn",
                   f"{cert_days}d remaining" if cert_days else cert_summary.get("message", ""))
    else:
        add_check("certificate_expiry", "pass",
                   f"{cert_days}d remaining" if cert_days else cert_summary.get("message", ""))

    # 8. Disk usage (/)
    try:
        r = run_cmd(["df", "--output=pcent", "/"], timeout=5)
        for line in r.stdout.strip().splitlines():
            line = line.strip().rstrip("%")
            if line.isdigit():
                pct = int(line)
                if pct > 90:
                    add_check("disk_usage", "fail", f"{pct}% used")
                elif pct >= 80:
                    add_check("disk_usage", "warn", f"{pct}% used")
                else:
                    add_check("disk_usage", "pass", f"{pct}% used")
                break
        else:
            add_check("disk_usage", "warn", "unable to parse disk usage")
    except Exception as e:
        add_check("disk_usage", "warn", str(e))

    # 9. Upgrade state
    last_attempt = read_state_json(LAST_ATTEMPT_PATH)
    if last_attempt:
        attempt_status = last_attempt.get("status", "unknown")
        if attempt_status in ("success", "complete"):
            add_check("upgrade_state", "pass", f"last attempt: {attempt_status}")
        else:
            add_check("upgrade_state", "fail", f"last attempt: {attempt_status}")
    else:
        add_check("upgrade_state", "pass", "no upgrade attempted")

    # Overall verdict
    statuses = [c["status"] for c in checks]
    if "fail" in statuses:
        overall = "fail"
    elif "warn" in statuses:
        overall = "warn"
    else:
        overall = "pass"

    report = {
        "overall_status": overall,
        "generated_at": datetime.utcnow().isoformat() + "Z",
        "checks": checks,
    }

    if json_mode:
        print(json.dumps(report, indent=2))
        return

    print("NPM Health Report")
    print("=" * 60)
    for c in checks:
        tag = {"pass": "PASS", "warn": "WARN", "fail": "FAIL"}.get(c["status"], "????")
        print(f"  [{tag}]  {c['check']:.<30s} {c['detail']}")
    print("=" * 60)
    print(f"  Overall: {overall.upper()}")
    print("")

    fail_count = sum(1 for c in checks if c["status"] == "fail")
    warn_count = sum(1 for c in checks if c["status"] == "warn")
    pass_count = sum(1 for c in checks if c["status"] == "pass")
    print(f"NORTHSTAR_HEALTH_REPORT overall={overall} failed={fail_count}"
          f" warned={warn_count} passed={pass_count}")

    if overall == "fail":
        sys.exit(1)


KPI_HISTORY_PATH = f"{BACKUP_STATE_DIR}/reports/kpi-history.jsonl"
KPI_HISTORY_MAX_ENTRIES = 90


def _append_kpi_snapshot(kpis: dict) -> None:
    """Append a KPI snapshot to the JSONL history file and prune old entries."""
    history_path = Path(KPI_HISTORY_PATH)
    history_path.parent.mkdir(parents=True, exist_ok=True)
    entry = json.dumps({"timestamp": datetime.utcnow().isoformat() + "Z", "kpis": kpis})
    try:
        lines = []
        if history_path.exists():
            lines = history_path.read_text(encoding="utf-8").strip().splitlines()
        lines.append(entry)
        if len(lines) > KPI_HISTORY_MAX_ENTRIES:
            lines = lines[-KPI_HISTORY_MAX_ENTRIES:]
        history_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
        os.chmod(history_path, 0o640)
    except Exception:
        pass


def _print_kpi_trend(json_mode: bool = False) -> None:
    """Read KPI history and print trend summary."""
    history_path = Path(KPI_HISTORY_PATH)
    if not history_path.exists():
        if json_mode:
            print(json.dumps({"error": "no KPI history found", "snapshots": 0}))
        else:
            print("No KPI history found. History is captured daily via the health-report timer.")
        return

    entries = []
    for line in history_path.read_text(encoding="utf-8").strip().splitlines():
        try:
            entries.append(json.load(__import__("io").StringIO(line)))
        except Exception:
            pass

    if not entries:
        if json_mode:
            print(json.dumps({"error": "no valid KPI entries", "snapshots": 0}))
        else:
            print("No valid KPI entries found.")
        return

    now = datetime.utcnow()
    last_7d = [e for e in entries if _entry_age_days(e, now) <= 7]
    last_30d = [e for e in entries if _entry_age_days(e, now) <= 30]

    def _avg(entries_subset, key):
        vals = [e.get("kpis", {}).get(key) for e in entries_subset if e.get("kpis", {}).get(key) is not None]
        return round(sum(vals) / len(vals), 1) if vals else None

    def _count_true(entries_subset, key):
        return sum(1 for e in entries_subset if e.get("kpis", {}).get(key))

    trend = {
        "total_snapshots": len(entries),
        "last_7d_snapshots": len(last_7d),
        "last_30d_snapshots": len(last_30d),
        "backup_success_rate_7d_avg": _avg(last_7d, "backup_success_rate_pct"),
        "backup_success_rate_30d_avg": _avg(last_30d, "backup_success_rate_pct"),
        "restore_verify_pass_rate_7d_avg": _avg(last_7d, "restore_verify_pass_rate_pct"),
        "restore_verify_pass_rate_30d_avg": _avg(last_30d, "restore_verify_pass_rate_pct"),
        "rollback_ready_30d_count": _count_true(last_30d, "rollback_ready"),
        "latest": entries[-1].get("kpis", {}) if entries else {},
    }

    if json_mode:
        print(json.dumps({"generated_at": now.isoformat() + "Z", "trend": trend}, indent=2))
        return

    print(f"NPM Reliability Trend (last 30 days, {len(last_30d)} snapshots)")
    print("=" * 60)
    br_30 = trend["backup_success_rate_30d_avg"]
    br_latest = entries[-1].get("kpis", {}).get("backup_success_rate_pct") if entries else None
    print(f"  Backup success rate:        {f'{br_30}%' if br_30 is not None else 'N/A':>8s} (avg)"
          f" / {f'{br_latest}%' if br_latest is not None else 'N/A'} (latest)")
    rv_30 = trend["restore_verify_pass_rate_30d_avg"]
    rv_latest = entries[-1].get("kpis", {}).get("restore_verify_pass_rate_pct") if entries else None
    print(f"  Restore verify pass rate:   {f'{rv_30}%' if rv_30 is not None else 'N/A':>8s} (avg)"
          f" / {f'{rv_latest}%' if rv_latest is not None else 'N/A'} (latest)")
    rb_count = trend["rollback_ready_30d_count"]
    print(f"  Rollback ready:             {rb_count}/{len(last_30d)} days")
    print("=" * 60)


def _entry_age_days(entry: dict, now) -> float:
    try:
        ts = entry.get("timestamp", "")
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00")).replace(tzinfo=None)
        return (now - dt).total_seconds() / 86400
    except Exception:
        return 9999


def cmd_reliability_report(json_mode: bool = False, history: bool = False) -> None:
    """Compute runtime reliability KPIs from sentinel files and reports."""
    if history:
        _print_kpi_trend(json_mode)
        return

    kpis = {}

    # Instance uptime
    try:
        r = run_cmd(["cat", "/proc/uptime"], timeout=5)
        uptime_secs = float(r.stdout.strip().split()[0])
        kpis["instance_uptime_seconds"] = round(uptime_secs, 1)
        days = int(uptime_secs // 86400)
        hours = int((uptime_secs % 86400) // 3600)
        kpis["instance_uptime_human"] = f"{days}d {hours}h"
    except Exception:
        kpis["instance_uptime_seconds"] = None
        kpis["instance_uptime_human"] = "unknown"

    # Last successful backup age
    sentinel_success = read_sentinel_file(SENTINEL_LAST_SUCCESS)
    if sentinel_success:
        kpis["last_backup_success"] = sentinel_success
        try:
            ts_str = sentinel_success.split()[0]
            last_dt = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
            age_h = (datetime.now(last_dt.tzinfo) - last_dt).total_seconds() / 3600
            kpis["last_backup_age_hours"] = round(age_h, 1)
        except Exception:
            kpis["last_backup_age_hours"] = None
    else:
        kpis["last_backup_success"] = None
        kpis["last_backup_age_hours"] = None

    # Backup success rate from journal (count backup sentinel writes)
    backup_total = 0
    backup_ok = 0
    try:
        r = run_cmd(
            ["journalctl", "-u", "npm-backup.service", "--no-pager", "-o", "cat"],
            timeout=15,
        )
        for line in r.stdout.splitlines():
            if "NORTHSTAR_BACKUP" in line and "status=" in line:
                backup_total += 1
                if "status=success" in line:
                    backup_ok += 1
    except Exception:
        pass
    kpis["backup_total_runs"] = backup_total
    kpis["backup_success_runs"] = backup_ok
    kpis["backup_success_rate_pct"] = (
        round(100.0 * backup_ok / backup_total, 1) if backup_total > 0 else None
    )

    # Restore verification pass rate from stored reports
    reports_dir = Path(BACKUP_STATE_DIR) / "reports"
    rv_total = 0
    rv_pass = 0
    if reports_dir.is_dir():
        for rp in sorted(reports_dir.glob("restore-verify-*.json")):
            try:
                with open(rp, "r", encoding="utf-8") as f:
                    rd = json.load(f)
                rv_total += 1
                if rd.get("status") == "pass":
                    rv_pass += 1
            except Exception:
                pass
    kpis["restore_verify_total"] = rv_total
    kpis["restore_verify_pass"] = rv_pass
    kpis["restore_verify_pass_rate_pct"] = (
        round(100.0 * rv_pass / rv_total, 1) if rv_total > 0 else None
    )

    # Latest restore verification
    rv_latest = read_state_json(RESTORE_VERIFY_REPORT_DEFAULT)
    kpis["restore_verify_latest_status"] = rv_latest.get("status") if rv_latest else None
    kpis["restore_verify_latest_at"] = rv_latest.get("generated_at_utc") if rv_latest else None

    # Last upgrade status
    last_attempt = read_state_json(LAST_ATTEMPT_PATH)
    if last_attempt:
        kpis["last_upgrade_status"] = last_attempt.get("status", "unknown")
        kpis["last_upgrade_at"] = last_attempt.get("timestamp", last_attempt.get("started_at"))
    else:
        kpis["last_upgrade_status"] = None
        kpis["last_upgrade_at"] = None

    # Rollback readiness
    lkg = read_state_json(LAST_KNOWN_GOOD_PATH)
    rollback_ready = False
    if lkg:
        bp = lkg.get("backup_path", "")
        rollback_ready = bool(bp and Path(bp).exists())
    kpis["rollback_ready"] = rollback_ready

    _append_kpi_snapshot(kpis)

    report = {
        "generated_at": datetime.utcnow().isoformat() + "Z",
        "kpis": kpis,
    }

    if json_mode:
        print(json.dumps(report, indent=2))
        return

    print("NPM Reliability Report")
    print("=" * 60)
    print(f"  Instance uptime:            {kpis['instance_uptime_human']}")
    print("")
    print("  Backup")
    print("  " + "-" * 56)
    if kpis["backup_success_rate_pct"] is not None:
        print(f"    Success rate:             {kpis['backup_success_rate_pct']}%"
              f"  ({kpis['backup_success_runs']}/{kpis['backup_total_runs']} runs)")
    else:
        print("    Success rate:             N/A (no runs recorded)")
    if kpis["last_backup_age_hours"] is not None:
        print(f"    Last success age:         {kpis['last_backup_age_hours']}h")
    else:
        print("    Last success age:         never")
    print("")
    print("  Restore Verification")
    print("  " + "-" * 56)
    if kpis["restore_verify_pass_rate_pct"] is not None:
        print(f"    Pass rate:                {kpis['restore_verify_pass_rate_pct']}%"
              f"  ({kpis['restore_verify_pass']}/{kpis['restore_verify_total']} reports)")
    else:
        print("    Pass rate:                N/A (no reports)")
    print(f"    Latest result:            {kpis['restore_verify_latest_status'] or 'none'}")
    print("")
    print("  Upgrade & Rollback")
    print("  " + "-" * 56)
    print(f"    Last upgrade status:      {kpis['last_upgrade_status'] or 'no upgrade attempted'}")
    print(f"    Rollback ready:           {'yes' if kpis['rollback_ready'] else 'no'}")
    print("=" * 60)


