def _get_sshd_config_cache() -> dict:
    """Parse sshd -T output into a lowercase key-value dict (cached)."""
    if not hasattr(_get_sshd_config_cache, "_cache"):
        cfg = {}
        try:
            r = run_cmd(["sshd", "-T"], timeout=5)
            if r.returncode == 0:
                for line in r.stdout.splitlines():
                    parts = line.strip().split(None, 1)
                    if len(parts) == 2:
                        cfg[parts[0].lower()] = parts[1].lower()
        except Exception:
            pass
        _get_sshd_config_cache._cache = cfg
    return _get_sshd_config_cache._cache


def _run_compliance_check(check: dict) -> dict:
    """Execute a single compliance check and return result dict."""
    result = {"name": check["name"], "cis": check["cis"], "status": "fail", "actual": "unknown"}
    method = check["method"]

    try:
        if method == "sshd":
            cfg = _get_sshd_config_cache()
            actual = cfg.get(check["key"], "")
            result["actual"] = actual or "(not set)"
            if "expected" in check:
                result["status"] = "pass" if actual == check["expected"] else "fail"
            elif "expected_not" in check:
                result["status"] = "pass" if actual and actual != check["expected_not"] else "fail"

        elif method == "sysctl":
            r = run_cmd(["sysctl", "-n", check["key"]], timeout=5)
            actual = r.stdout.strip()
            result["actual"] = actual
            result["status"] = "pass" if actual == check["expected"] else "fail"

        elif method == "ufw_active":
            r = run_cmd(["ufw", "status"], timeout=5)
            active = "Status: active" in r.stdout
            result["actual"] = "active" if active else "inactive"
            result["status"] = "pass" if active else "fail"

        elif method == "ufw_default_deny":
            r = run_cmd(["ufw", "status", "verbose"], timeout=5)
            result["actual"] = "unknown"
            for line in r.stdout.splitlines():
                if "Default:" in line and "deny (incoming)" in line:
                    result["actual"] = "deny (incoming)"
                    result["status"] = "pass"
                    break
            if result["status"] != "pass":
                result["actual"] = "not deny"

        elif method == "systemd_active":
            r = run_cmd(["systemctl", "is-active", check["key"]], timeout=5)
            actual = r.stdout.strip()
            result["actual"] = actual
            result["status"] = "pass" if actual == "active" else "fail"

        elif method == "fail2ban_jail":
            r = run_cmd(["fail2ban-client", "status", "sshd"], timeout=5)
            result["actual"] = "enabled" if r.returncode == 0 else "missing/disabled"
            result["status"] = "pass" if r.returncode == 0 else "fail"

    except Exception as e:
        result["actual"] = f"error: {e}"
        result["status"] = "fail"

    return result


def cmd_compliance_report(json_mode: bool = False) -> None:
    """Runtime verification of CIS benchmark hardening controls."""
    require_root("compliance-report")
    results = [_run_compliance_check(c) for c in CIS_CHECKS]

    pass_count = sum(1 for r in results if r["status"] == "pass")
    fail_count = sum(1 for r in results if r["status"] == "fail")
    overall = "pass" if fail_count == 0 else "fail"

    report = {
        "generated_at": datetime.utcnow().isoformat() + "Z",
        "benchmark": "CIS Ubuntu Linux 22.04 LTS Benchmark v1.0.0",
        "overall_status": overall,
        "passed": pass_count,
        "failed": fail_count,
        "total": len(results),
        "checks": results,
    }

    if json_mode:
        print(json.dumps(report, indent=2))
        return

    print("NPM Compliance Report")
    print("CIS Ubuntu Linux 22.04 LTS Benchmark v1.0.0")
    print("=" * 72)
    for r in results:
        tag = "PASS" if r["status"] == "pass" else "FAIL"
        print(f"  [{tag}]  {r['name']:.<42s} CIS {r['cis']:<14s} {r['actual']}")
    print("=" * 72)
    print(f"  Overall: {overall.upper()}  ({pass_count} passed, {fail_count} failed)")
    print("")
    print("  Disclaimer: This is a guidance mapping. Run CIS-CAT or equivalent")
    print("  auditing tools for formal compliance assessment.")
    print("")

    if overall == "fail":
        sys.exit(1)


NPM_IMAGE_CONFIG = "/etc/northstar/npm-image.conf"


def cmd_set_channel(channel: str) -> None:
    """Switch NPM image to stable (pinned) or edge (latest) channel."""
    require_root("set-channel")
    channel = (channel or "").strip().lower()
    if channel not in ("stable", "edge"):
        print("Error: channel must be 'stable' or 'edge'.")
        sys.exit(1)

    stable_tag = read_config_value(NPM_IMAGE_CONFIG, "channel", "stable_tag", fallback="2.13.5")
    edge_tag = read_config_value(NPM_IMAGE_CONFIG, "channel", "edge_tag", fallback="latest")
    tag = stable_tag.strip() if channel == "stable" else edge_tag.strip()
    if not tag:
        print(f"Error: {channel}_tag not set in {NPM_IMAGE_CONFIG}")
        sys.exit(1)

    print(f"Switching to channel '{channel}' (tag: {tag})...")
    result = run_cmd(["/usr/local/bin/npm-update-container", tag], timeout=1800)
    sys.exit(result.returncode)


