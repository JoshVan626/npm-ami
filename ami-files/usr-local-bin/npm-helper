def confirm_sensitive_action(assume_yes: bool, action_label: str) -> None:
    if assume_yes:
        return
    if not sys.stdin.isatty():
        print(f"Error: {action_label} requires confirmation. Re-run with --yes.")
        sys.exit(1)
    response = input(f"WARNING: This will display sensitive credentials. Type 'yes' to continue: ")
    if response.strip().lower() != "yes":
        print("Aborted.")
        sys.exit(1)


def log_credential_access(user: str) -> None:
    log_path = Path(CRED_ACCESS_LOG)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(log_path.parent, 0o750)
    try:
        os.chown(log_path.parent, 0, 0)
    except PermissionError:
        pass

    timestamp = time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime())
    entry = f"{timestamp} user={user} action=show-creds\n"
    with open(log_path, "a", encoding="utf-8") as log_file:
        log_file.write(entry)
    os.chmod(log_path, 0o600)
    try:
        os.chown(log_path, 0, 0)
    except PermissionError:
        pass


