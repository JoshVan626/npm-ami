            dry_run=getattr(args, "dry_run", False),
            region_override=getattr(args, "region", "") or "",
            alarm_action_arns=getattr(args, "alarm_action_arns", []) or [],
            ok_action_arns=getattr(args, "ok_action_arns", []) or [],
        )
    elif args.command == "backup":
        if args.backup_action == "verify":
            cmd_backup_verify()
        else:
            print("Error: invalid backup action.")
            sys.exit(1)
    elif args.command == "restore":
        cmd_restore(
            getattr(args, "backup_path", None),
            dry_run=getattr(args, "dry_run", False),
            verify=getattr(args, "verify", False),
            report_file=getattr(args, "report_file", RESTORE_VERIFY_REPORT_DEFAULT),
        )
    elif args.command == "diagnostics":
        cmd_diagnostics(json_mode=getattr(args, "json", False))
    elif args.command == "health-report":
        cmd_health_report(json_mode=getattr(args, "json", False))
    elif args.command == "reliability-report":
        cmd_reliability_report(
            json_mode=getattr(args, "json", False),
            history=getattr(args, "history", False),
        )
    elif args.command == "compliance-report":
        cmd_compliance_report(json_mode=getattr(args, "json", False))
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
