def require_root(action_name: str) -> None:
    if os.geteuid() != 0:
        print(f"Error: '{action_name}' requires root privileges.")
        print(f"Run: sudo npm-helper {action_name}")
        sys.exit(1)


def run_cmd(cmd, *, cwd=None, timeout=60, check=False):
    return subprocess.run(
        cmd,
        cwd=cwd,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=check,
    )


def read_config_value(config_path: str, section: str, key: str, fallback=None):
    config = configparser.ConfigParser()
    try:
        config.read(config_path)
        return config.get(section, key, fallback=fallback)
    except Exception:
        return fallback


def read_config_int(config_path: str, section: str, key: str, fallback: int) -> int:
    value = read_config_value(config_path, section, key, fallback=str(fallback))
    try:
        return int(str(value).strip())
    except Exception:
        return fallback


def get_backup_dir() -> str:
    return read_config_value(BACKUP_CONFIG, "backup", "local_backup_dir", fallback=BACKUP_DIR)


def get_backup_retention() -> int:
    return read_config_int(BACKUP_CONFIG, "backup", "local_retention", fallback=7)


def ensure_upgrade_state_dir() -> None:
    Path(UPGRADE_STATE_DIR).mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(UPGRADE_STATE_DIR, 0o750)
    except Exception:
        pass


def write_state_json(path: str, payload: dict) -> None:
    ensure_upgrade_state_dir()
    tmp_path = f"{path}.tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2, sort_keys=True)
        f.write("\n")
    try:
        os.chmod(tmp_path, 0o640)
    except Exception:
        pass
    os.replace(tmp_path, path)


def read_state_json(path: str):
    p = Path(path)
    if not p.exists():
        return None
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def get_compose_image(compose_file: Path):
    try:
        text = compose_file.read_text(encoding="utf-8")
    except Exception:
        return None
    match = re.search(r'(?m)^[ \t]*image:[ \t]*"?([^"\n]+)"?[ \t]*$', text)
    if not match:
        return None
    return match.group(1).strip()


def set_compose_image(compose_file: Path, image: str) -> bool:
    try:
        text = compose_file.read_text(encoding="utf-8")
    except Exception:
        return False
    pattern = re.compile(r'(?m)^([ \t]*image:[ \t]*).*$')
    if not pattern.search(text):
        return False
    updated = pattern.sub(rf'\1"{image}"', text, count=1)
    compose_file.write_text(updated, encoding="utf-8")
    return True


def check_npm_health(compose_dir: str, timeout_seconds: int = 90):
    deadline = time.time() + timeout_seconds
    last_container_state = "unknown"
    last_http81 = None
    last_http_api = None
    while time.time() < deadline:
        ps = run_cmd(["docker", "compose", "ps", "--format", "json"], cwd=compose_dir, timeout=10)
        containers = []
        if ps.returncode == 0 and ps.stdout.strip():
            for line in ps.stdout.strip().splitlines():
                try:
                    containers.append(json.loads(line))
                except Exception:
                    continue

        if containers:
            running = [c for c in containers if str(c.get("State", "")).lower() == "running"]
            if running:
                unhealthy = [c for c in running if str(c.get("Health", "")).lower() == "unhealthy"]
                if not unhealthy:
                    last_container_state = "running"
                else:
                    last_container_state = "unhealthy"
            else:
                last_container_state = "not_running"

        if shutil.which("curl"):
            c81 = run_cmd(["curl", "-sS", "-m", "5", "-o", "/dev/null", "-w", "%{http_code}", "http://127.0.0.1:81"], timeout=10)
            capi = run_cmd(["curl", "-sS", "-m", "5", "-o", "/dev/null", "-w", "%{http_code}", "http://127.0.0.1:81/api"], timeout=10)
            last_http81 = c81.stdout.strip() if c81.returncode == 0 else "000"
            last_http_api = capi.stdout.strip() if capi.returncode == 0 else "000"

            if (
                last_container_state == "running"
                and re.match(r"^[23][0-9][0-9]$", last_http81 or "")
                and re.match(r"^[23][0-9][0-9]$", last_http_api or "")
            ):
                return {
                    "ok": True,
                    "container_state": last_container_state,
                    "http_81": last_http81,
                    "http_api": last_http_api,
                }

        time.sleep(3)

    return {
        "ok": False,
        "container_state": last_container_state,
        "http_81": last_http81,
        "http_api": last_http_api,
    }


def run_or_print(cmd, dry_run: bool = False):
    if dry_run:
        print(f"[dry-run] {shlex.join(cmd)}")
        return 0
    result = run_cmd(cmd, timeout=120)
    if result.returncode != 0:
        if result.stdout.strip():
            print(result.stdout.strip())
        if result.stderr.strip():
            print(result.stderr.strip())
    return result.returncode


def get_imds_token():
    token = run_cmd(
        [
            "curl",
            "-sS",
            "-m",
            "1",
            "-X",
            "PUT",
            "http://169.254.169.254/latest/api/token",
            "-H",
            "X-aws-ec2-metadata-token-ttl-seconds: 60",
        ],
        timeout=2,
    )
    if token.returncode != 0 or not token.stdout.strip():
        return None
    return token.stdout.strip()


def get_imds_value(path: str, token: str):
    result = run_cmd(
        [
            "curl",
            "-sS",
            "-m",
            "1",
            "-H",
            f"X-aws-ec2-metadata-token: {token}",
            f"http://169.254.169.254/latest/{path}",
        ],
        timeout=2,
    )
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    return value if value else None


def substitute_obj(obj, replacements: dict):
    if isinstance(obj, dict):
        return {k: substitute_obj(v, replacements) for k, v in obj.items()}
    if isinstance(obj, list):
        return [substitute_obj(i, replacements) for i in obj]
    if isinstance(obj, str):
        out = obj
        for key, value in replacements.items():
            out = out.replace(key, value)
        return out
    return obj


def cmd_observability(
    action: str,
    dry_run: bool = False,
    region_override: str = "",
    alarm_action_arns=None,
    ok_action_arns=None,
) -> None:
    """
    Manage opt-in CloudWatch observability baseline.
    """
    require_root(f"observability {action}")
    if action not in ("enable", "disable", "status"):
        print("Error: invalid observability action.")
        sys.exit(1)

    service = "amazon-cloudwatch-agent.service"
    st = systemd_unit_status(service, [])
    token = get_imds_token()
    instance_id = get_imds_value("meta-data/instance-id", token) if token else None
    az = get_imds_value("meta-data/placement/availability-zone", token) if token else None
    region = region_override.strip() or ((az[:-1]) if az and len(az) > 1 else "")

    alarm_action_arns = alarm_action_arns or []
    ok_action_arns = ok_action_arns or []

    if action == "status":
        print("Observability status")
        print("=" * 50)
        print(f"CloudWatch agent active={st.get('active')} enabled={st.get('enabled')}")
        state = read_state_json(OBS_STATE_PATH)
        if state:
            print(f"State file: {OBS_STATE_PATH}")
            print(f"Enabled: {state.get('enabled')}")
            print(f"Dashboard: {state.get('dashboard_name')}")
            alarms = state.get("alarm_names") or []
            if alarms:
                print("Alarms:")
                for a in alarms:
                    print(f" - {a}")
            alarm_actions = state.get("alarm_action_arns") or []
            if alarm_actions:
                print("Alarm action ARNs:")
                for a in alarm_actions:
                    print(f" - {a}")
            ok_actions = state.get("ok_action_arns") or []
            if ok_actions:
                print("OK action ARNs:")
                for a in ok_actions:
                    print(f" - {a}")
        else:
            print("State file: not found")
        if instance_id:
            print(f"InstanceId: {instance_id}")
        if region:
            print(f"Region: {region}")
        sys.exit(0)

    if not shutil.which("aws"):
        print("Error: aws CLI is required for observability enable/disable.")
        sys.exit(1)
    if not token or not instance_id or not region:
        print("Error: unable to determine instance identity/region from IMDSv2.")
        print("Attach an instance profile and run on EC2, or pass --region where applicable.")
        sys.exit(1)
    if not Path(CW_AGENT_CONFIG).exists():
        print(f"Error: CloudWatch agent config missing: {CW_AGENT_CONFIG}")
        sys.exit(1)

    state = read_state_json(OBS_STATE_PATH) or {}
    dashboard_name = f"northstar-npm-{instance_id}"
    alarm_names = []
    metric_filter_names = []
    cleaned_alarm_actions = []
    cleaned_ok_actions = []
    if alarm_action_arns:
        for arn in alarm_action_arns:
            value = (arn or "").strip()
            if not value:
                continue
            if not value.startswith("arn:aws:sns:"):
                print(f"Error: invalid alarm action ARN (must be SNS ARN): {value}")
                sys.exit(1)
            if value not in cleaned_alarm_actions:
                cleaned_alarm_actions.append(value)
    if ok_action_arns:
        for arn in ok_action_arns:
            value = (arn or "").strip()
            if not value:
                continue
            if not value.startswith("arn:aws:sns:"):
                print(f"Error: invalid OK action ARN (must be SNS ARN): {value}")
                sys.exit(1)
            if value not in cleaned_ok_actions:
                cleaned_ok_actions.append(value)

    if action == "enable":
        if not Path(CW_DASHBOARD_TEMPLATE).exists() or not Path(CW_ALARMS_TEMPLATE).exists():
            print("Error: observability templates are missing under /opt/aws/amazon-cloudwatch-agent.")
            sys.exit(1)
        try:
            dashboard = json.loads(Path(CW_DASHBOARD_TEMPLATE).read_text(encoding="utf-8"))
            alarms = json.loads(Path(CW_ALARMS_TEMPLATE).read_text(encoding="utf-8"))
        except Exception as e:
            print(f"Error: failed to parse observability templates: {e}")
            sys.exit(1)

        replacements = {
            "__INSTANCE_ID__": instance_id,
            "__REGION__": region,
            "__LOG_GROUP__": CW_LOG_GROUP,
            "__NAMESPACE__": CW_NAMESPACE,
        }
        dashboard = substitute_obj(dashboard, replacements)
        alarms = substitute_obj(alarms, replacements)

        print("Enabling observability baseline...")
        if run_or_print(["systemctl", "enable", "--now", service], dry_run=dry_run) != 0:
            sys.exit(1)

        dash_body = json.dumps(dashboard, separators=(",", ":"))
        if run_or_print(
            [
                "aws",
                "cloudwatch",
                "put-dashboard",
                "--region",
                region,
                "--dashboard-name",
                dashboard_name,
                "--dashboard-body",
                dash_body,
            ],
            dry_run=dry_run,
        ) != 0:
            sys.exit(1)

        for mf in alarms.get("metric_filters", []):
            mf_name = mf.get("name")
            metric_filter_names.append(mf_name)
            if run_or_print(
                [
                    "aws",
                    "logs",
                    "put-metric-filter",
                    "--region",
                    region,
                    "--log-group-name",
                    mf.get("log_group", CW_LOG_GROUP),
                    "--filter-name",
                    mf_name,
                    "--filter-pattern",
                    mf.get("pattern", ""),
                    "--metric-transformations",
                    f"metricName={mf.get('metric_name')},metricNamespace={mf.get('metric_namespace')},metricValue={mf.get('metric_value', '1')},defaultValue={mf.get('default_value', '0')}",
                ],
                dry_run=dry_run,
            ) != 0:
                sys.exit(1)

        for alarm in alarms.get("alarms", []):
            alarm_name = alarm.get("name")
            alarm_names.append(alarm_name)
            cmd = [
                "aws",
                "cloudwatch",
                "put-metric-alarm",
                "--region",
                region,
                "--alarm-name",
                alarm_name,
                "--alarm-description",
                alarm.get("description", "Northstar NPM baseline alarm"),
                "--namespace",
                alarm.get("namespace", CW_NAMESPACE),
                "--metric-name",
                alarm.get("metric_name"),
                "--statistic",
                alarm.get("statistic", "Average"),
                "--period",
                str(alarm.get("period", 300)),
                "--evaluation-periods",
                str(alarm.get("evaluation_periods", 3)),
                "--threshold",
                str(alarm.get("threshold", 80)),
                "--comparison-operator",
                alarm.get("comparison_operator", "GreaterThanThreshold"),
                "--treat-missing-data",
                alarm.get("treat_missing_data", "missing"),
            ]
            dims = [f"Name={dim.get('name')},Value={dim.get('value')}" for dim in alarm.get("dimensions", [])]
            if dims:
                cmd.extend(["--dimensions"] + dims)
            if cleaned_alarm_actions:
                cmd.extend(["--alarm-actions"] + cleaned_alarm_actions)
            if cleaned_ok_actions:
                cmd.extend(["--ok-actions"] + cleaned_ok_actions)
            if run_or_print(cmd, dry_run=dry_run) != 0:
                sys.exit(1)

        state = {
            "enabled": True,
            "updated_at": datetime.utcnow().isoformat() + "Z",
            "instance_id": instance_id,
            "region": region,
            "dashboard_name": dashboard_name,
            "alarm_names": alarm_names,
            "metric_filter_names": metric_filter_names,
            "alarm_action_arns": cleaned_alarm_actions,
            "ok_action_arns": cleaned_ok_actions,
            "log_group": CW_LOG_GROUP,
            "required_iam_actions": [
                "cloudwatch:PutDashboard",
                "cloudwatch:PutMetricAlarm",
                "cloudwatch:DeleteAlarms",
                "cloudwatch:DeleteDashboards",
                "logs:PutMetricFilter",
                "logs:DeleteMetricFilter",
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "cloudwatch:PutMetricData",
            ],
        }
        if cleaned_alarm_actions or cleaned_ok_actions:
            state["required_iam_actions"].append("sns:Publish")
        if not dry_run:
            write_state_json(OBS_STATE_PATH, state)
        print("Observability baseline enabled.")
        sys.exit(0)

    # disable
    print("Disabling observability baseline...")
    dashboard_to_delete = state.get("dashboard_name", dashboard_name)
    for alarm_name in state.get("alarm_names", []):
        run_or_print(["aws", "cloudwatch", "delete-alarms", "--region", region, "--alarm-names", alarm_name], dry_run=dry_run)
    if dashboard_to_delete:
        run_or_print(["aws", "cloudwatch", "delete-dashboards", "--region", region, "--dashboard-names", dashboard_to_delete], dry_run=dry_run)
    for mf_name in state.get("metric_filter_names", []):
        run_or_print(
            ["aws", "logs", "delete-metric-filter", "--region", region, "--log-group-name", CW_LOG_GROUP, "--filter-name", mf_name],
            dry_run=dry_run,
        )
    run_or_print(["systemctl", "disable", "--now", service], dry_run=dry_run)
    if not dry_run:
        write_state_json(
            OBS_STATE_PATH,
            {
                "enabled": False,
                "updated_at": datetime.utcnow().isoformat() + "Z",
                "instance_id": instance_id,
                "region": region,
                "dashboard_name": dashboard_to_delete,
                "alarm_names": [],
                "metric_filter_names": [],
                "alarm_action_arns": [],
                "ok_action_arns": [],
                "log_group": CW_LOG_GROUP,
            },
        )
    print("Observability baseline disabled.")
    sys.exit(0)


def parse_cert_expiry(cert_path: Path):
    try:
        result = run_cmd(["openssl", "x509", "-enddate", "-noout", "-in", str(cert_path)], timeout=10)
    except FileNotFoundError:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        return None
    line = result.stdout.strip()
    if not line.startswith("notAfter="):
        return None
    raw = line.split("=", 1)[1].strip()
    try:
        if raw.endswith("GMT"):
            raw = raw.replace(" GMT", "")
        expiry = datetime.strptime(raw, "%b %d %H:%M:%S %Y")
        return expiry
    except Exception:
        return None


def find_cert_files():
    cert_files = []
    seen = set()
    for base in CERT_SEARCH_DIRS:
        path = Path(base)
        if not path.is_dir():
            continue
        for name in ("fullchain.pem", "cert.pem"):
            for cert in path.rglob(name):
                if cert.is_file():
                    if cert.resolve() in seen:
                        continue
                    cert_files.append(cert)
                    seen.add(cert.resolve())
    return cert_files


def get_cert_expiry_summary(threshold_days: int):
    certs = find_cert_files()
    if not certs:
        return {"status": "none", "message": "no certificates found"}

    now = datetime.utcnow()
    soonest = None
    soonest_path = None
    for cert in certs:
        expiry = parse_cert_expiry(cert)
        if not expiry:
            continue
        if soonest is None or expiry < soonest:
            soonest = expiry
            soonest_path = cert

    if not soonest:
        return {"status": "unknown", "message": "unable to parse certificate expiry"}

    days_remaining = int((soonest - now).total_seconds() / 86400)
    status = "warn" if days_remaining <= threshold_days else "ok"
    message = f"next expiry {soonest.strftime('%Y-%m-%d')} (in {days_remaining} days)"
    if soonest_path:
        message = f"{message} at {soonest_path}"
    return {
        "status": status,
        "message": message,
        "days_remaining": days_remaining,
        "path": str(soonest_path) if soonest_path else None,
    }


def cmd_update_os():
    """
    Run a one-click OS package upgrade (manual, opt-in).
    """
    require_root("update-os")

    start = time.time()
    print("WARNING: This will apply Ubuntu package updates and may require a reboot.")
    print("         Review changes and run during a maintenance window when possible.")
    print("")

    env = os.environ.copy()
    env["DEBIAN_FRONTEND"] = "noninteractive"

    try:
        print("Running: apt-get update")
        subprocess.run(["apt-get", "update"], env=env, check=True)

        print("")
        print("Running: apt-get upgrade -y --with-new-pkgs")
        subprocess.run(["apt-get", "upgrade", "-y", "--with-new-pkgs"], env=env, check=True)

    except subprocess.CalledProcessError as e:
        duration = int(time.time() - start)
        print(f"NORTHSTAR_UPDATE_OS status=failure duration_s={duration}")
        sys.exit(e.returncode if e.returncode != 0 else 1)

    duration = int(time.time() - start)

    if Path("/var/run/reboot-required").exists():
        print("")
        print("REBOOT REQUIRED")

    print(f"NORTHSTAR_UPDATE_OS status=success duration_s={duration}")
    sys.exit(0)


