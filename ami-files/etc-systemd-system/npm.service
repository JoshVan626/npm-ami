[Unit]
Description=Nginx Proxy Manager Docker Stack
Documentation=https://northstarcloud.io/docs/npm-ami
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/npm
ExecStart=/usr/local/bin/npm-stack-start
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300
TimeoutStopSec=120
Restart=on-failure
RestartSec=20s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

